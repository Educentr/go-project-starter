package logger

import (
	"context"
	"os"
	"strings"
	"time"

	"github.com/Educentr/go-onlineconf/pkg/onlineconf"
	"github.com/Educentr/go-project-starter-runtime/pkg/logger"
	{{ .Logger.Import }}
)

const (
	onlineconfLevelPath = "log_level"
	// onlineconfLevelDefaultNode — узел с базовым уровнем логирования внутри
	// поддерева владельца логгера.
	onlineconfLevelDefaultNode = "default"
)

// logLevelPath собирает абсолютный путь OnlineConf до узла с уровнем логирования.
//
// Инвариант префикса: ocPrefix — уже абсолютный путь поддерева, которому принадлежит
// логгер (транспорт, воркер), и он уже содержит имя сервиса, поэтому имя сервиса
// здесь не приписывается. Пустой ocPrefix означает процессный логгер — его уровень
// живёт в корне сервиса, поэтому префиксом становится serviceName.
//
// Компоненты, пустые после обрезки слэшей, выбрасываются: onlineconf.MakePath их не
// отбрасывает и вернул бы путь с "//", которого в дереве быть не может.
func logLevelPath(serviceName, ocPrefix, node string) string {
	if strings.Trim(ocPrefix, "/") == "" {
		ocPrefix = serviceName
	}

	parts := make([]string, 0, 3)

	for _, part := range []string{ocPrefix, node, onlineconfLevelPath} {
		if strings.Trim(part, "/") != "" {
			parts = append(parts, part)
		}
	}

	return onlineconf.MakePath(parts...)
}

func InitZlog(ctx context.Context, serviceName string) context.Context {
	zlog.TimeFieldFormat = zlog.TimeFormatUnixMs
	applog := logger.InitAppZlog(func(onlineconfPrefix, ocPath string) *zlog.Logger {
		var (
			levelGlob = zlog.InfoLevel
			levelEP   = zlog.InfoLevel
			zlogInst  = zlog.New(os.Stdout)
		)

		// Создаём новый экземпляр логерра
		devStand, err := onlineconf.GetBool(ctx, onlineconf.MakePath(serviceName, "devstand"), false)
		if err == nil && devStand {
			zlogInst = zlog.New(zlog.ConsoleWriter{Out: os.Stdout, TimeFormat: time.RFC3339})
		}

		zlogInst = zlogInst.With().Timestamp().Caller().Logger()

		levelCfg, err := onlineconf.GetString(
			ctx,
			logLevelPath(serviceName, onlineconfPrefix, onlineconfLevelDefaultNode),
			zlog.LevelInfoValue,
		)
		if err == nil {
			// Уровень логирования по умолчанию
			levelGlob, err = zlog.ParseLevel(levelCfg)
			if err != nil {
				levelGlob = zlog.InfoLevel
			}
		}

		// Уровень логирования переопределённый для данного endpoint-а.
		// Пустой ocPath означает, что переопределять нечего (процессный логгер),
		// — тогда чтения нет вовсе.
		var levelCfgEndpoint string

		if strings.Trim(ocPath, "/") != "" {
			levelCfgEndpoint, err = onlineconf.GetString(
				ctx,
				logLevelPath(serviceName, onlineconfPrefix, ocPath),
				"",
			)
			if err == nil {
				levelEP, err = zlog.ParseLevel(levelCfgEndpoint)
				// Если не получилось распарсить уровень то выставляем Info
				if err != nil {
					levelEP = zlog.InfoLevel
				}
			}
		}

		if levelCfgEndpoint != "" && levelCfgEndpoint != levelCfg {
			zlogInst = zlogInst.Level(levelEP)
		} else {
			zlogInst = zlogInst.Level(levelGlob)
		}

		return &zlogInst
	})

	// Добавим в контекст информацию о логгере
	ctx = applog.WrapZlog(ctx, "", "")

	{{ .Logger.InfoMsg "ctx" "zlog initialized"}}

	// Проинициализируем Zlog
	return logger.Wrap(ctx, applog)
}
