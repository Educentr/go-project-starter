type Worker struct {
	daemon.EmptyWorker
	Srv ds.IService
	jobState any
	// Таймеры цикла. Поля, а не package-level переменные с durationFromEnv в
	// инициализаторе: ENV читается в Create — в момент, который видно в main, — а
	// не как side-effect импорта пакета. Читаются через errorTimeout() /
	// newCycleTimeout(), там же лежат дефолты.
	loopErrorTimeout    time.Duration
	loopNewCycleTimeout time.Duration
}

const (
	DefaultBatchSize     = 100
	NextIterationTimeout = time.Millisecond * 1

	// Таймеры цикла по умолчанию — те же значения, что были захардкожены до
	// появления ENV-переопределения.
	DefaultErrorTimeout    = time.Second * 10
	DefaultNewCycleTimeout = time.Second * 10
)

func durationFromEnv(key string, def time.Duration) time.Duration {
	if v := os.Getenv(key); v != "" {
		if d, err := time.ParseDuration(v); err == nil {
			return d
		}
	}
	return def
}

const (
	nameFieldLogger = "Name"
	WorkerName      = "{{ .Worker.Name }}"
)

// SetLoopTimeouts переопределяет паузы цикла из Go.
//
// Прежде это делалось присваиванием экспортированных package-level переменных
// ErrorTimeout / NewCycleTimeout — чаще всего из теста проекта, чтобы цикл не
// держал тест десять секунд. Переменных больше нет, а ENV на процесс
// (WORKER_<NAME>_*) для теста неудобен: он глобален и зависит от порядка. Сеттер
// возвращает тот же воркер, поэтому вызов можно записать в одну строку:
//
//	w := Create().SetLoopTimeouts(10*time.Millisecond, 10*time.Millisecond)
//
// Неположительное значение означает «оставить дефолт» — см. errorTimeout.
func (w *Worker) SetLoopTimeouts(errorTimeout, newCycleTimeout time.Duration) *Worker {
	w.loopErrorTimeout = errorTimeout
	w.loopNewCycleTimeout = newCycleTimeout

	return w
}

// errorTimeout — пауза после ошибки получения задач.
//
// Ноль здесь значит «не задано», а не «не ждать»: воркер, собранный не через
// Create (&Worker{} в тесте проекта), с нулём крутил бы цикл на полной скорости и
// долбил бы отказывающий источник задач без паузы. Поэтому неположительное
// значение заменяется дефолтом.
func (w *Worker) errorTimeout() time.Duration {
	if w.loopErrorTimeout <= 0 {
		return DefaultErrorTimeout
	}

	return w.loopErrorTimeout
}

// newCycleTimeout — пауза перед новым циклом, когда источник задач вернул nil.
// Ноль трактуется так же, как в errorTimeout.
func (w *Worker) newCycleTimeout() time.Duration {
	if w.loopNewCycleTimeout <= 0 {
		return DefaultNewCycleTimeout
	}

	return w.loopNewCycleTimeout
}

func Create() *Worker {
    return &Worker{
        loopErrorTimeout:    durationFromEnv("WORKER_{{ .Worker.Name | ToUpper }}_ERROR_TIMEOUT", DefaultErrorTimeout),
        loopNewCycleTimeout: durationFromEnv("WORKER_{{ .Worker.Name | ToUpper }}_NEW_CYCLE_TIMEOUT", DefaultNewCycleTimeout),
    }
}

func (w *Worker) Name() string {
	return WorkerName
}

func (w *Worker) Init(ctx context.Context, serviceName, _ string, metrics *prometheus.Registry, srv ds.IService) error {
	w.Srv = srv
	return nil
}

func GetEnabledJobs(ctx context.Context) []string {
	enabledJobs, _, err := occonf.WorkerJobsEnabled(ctx, WorkerName)
	if err != nil {
		{{ $.Logger.ErrorMsg "ctx" "err" "get enabled jobs" }}

		return []string{}
	}

	if enabledJobs == nil {
		return []string{}
	}

	return enabledJobs
}

func GetBatchSize(ctx context.Context) uint32 {
	batchSize, ok, err := occonf.WorkerBatchSize(ctx, WorkerName)
	if err != nil {
		{{ $.Logger.ErrorMsg "ctx" "err" "get batch size" }}

		return DefaultBatchSize
	}

	if !ok {
		return DefaultBatchSize
	}

	if batchSize <= 0 || batchSize > math.MaxUint32 {
		{{ $.Logger.ErrorMsg "ctx" "err" "invalid batch size" }}

		return DefaultBatchSize
	}

	return uint32(batchSize)
}

// GetConfigPath returns this worker's OnlineConf subtree — the prefix the
// logger reads the log level below. The subtree is declared by the generator
// (daemon.go.tmpl.ockeys.yaml), which is why the path comes from the accessor
// package instead of being assembled out of segments here.
//
// It takes no key: a path composed here would address a node no declaration
// carries and no registry row shows, which is the thing the key map removes.
// Read a value through its accessor.
func GetConfigPath() string {
	return occonf.WorkerPath(WorkerName)
}

func (w *Worker) JobStarter(ctx context.Context, task daemon.ITask) (err error) {
	ocPrefix := GetConfigPath()

	defaultTimeout, _, err := occonf.WorkerDefaultTimeout(ctx, WorkerName)
	if err != nil {
		{{ .Logger.ErrorMsg "ctx" "err" "error getting default job timeout" "str::$nameFieldLogger::WorkerName" }}
	}

	jobTimeout, ok, err := occonf.WorkerJobTimeout(ctx, WorkerName)
	if err != nil {
		{{ .Logger.ErrorMsg "ctx" "err" "error getting job timeout" "str::$nameFieldLogger::WorkerName" }}
	}

	if !ok {
		jobTimeout = defaultTimeout
	}

	ctxJob, cancel, err := reqctx.CreateContextWithTimeout(ctx, ctx, jobTimeout)
	if err != nil {
		{{ .Logger.ErrorMsg "ctx" "err" "Failed to create job context" "str::$nameFieldLogger::WorkerName" }}
		return err
	}
	{{ .Logger.ReWrap "ctx" "ctxJob" "ocPrefix" "\"job\"" }}
	{{ .Logger.UpdateContext "ctxJob" "str::taskID::task.GetID(ctxJob)" "str::$nameFieldLogger::WorkerName" }}

	err = errors.New("unexpected error")

	defer func() {
		err := recover()
		if err != nil {
			{{ .Logger.ErrorMsg "ctxJob" "errors.New(\"panic catch\")" "panic" "any::panic error::err" "str::Stack::strings.Replace(strings.Replace(string(debug.Stack()), \"\\n\\t/\", \" --> /\", -1), \"\\n\", \" => \", -1)" }}
		}

		cancel()
	}()

	err = task.Do(ctxJob, w.Srv)
	if err != nil {
		{{ .Logger.ErrorMsg "ctxJob" "err" "Error job starter" "str::$nameFieldLogger::WorkerName" "str::taskID::task.GetID(ctxJob)"}}
	}

	return
}

// Run - start worker
func (w *Worker) Run(ctx context.Context, errGr *errgroup.Group) {
	// initialization worker
	errGr.Go(func() error {
		{{ .Logger.InfoMsg "ctx" "Run worker" "str::$nameFieldLogger::WorkerName" }}

		timer := time.NewTimer(time.Millisecond * 500)
		iterNum := 1

	JOB:
		for {
			select {
			case <-timer.C:
				iterNum++
				if iterNum % 100 == 0 {
					{{ .Logger.InfoMsg "ctx" "worker iteration" "int::iterNum::iterNum" "str::$nameFieldLogger::WorkerName" }}
				}

				tasks, jobState, err := w.GetTasks(ctx, w.jobState)
				if err != nil {
					{{ .Logger.ErrorMsg "ctx" "err" "Error get tasks" "str::$nameFieldLogger::WorkerName" }}
					timer = time.NewTimer(w.errorTimeout())
					continue
				}

				w.jobState = jobState

				if tasks == nil {
					{{ .Logger.InfoMsg "ctx" "tasks is nill. Probable new cycle started" "str::$nameFieldLogger::WorkerName" }}
					timer = time.NewTimer(w.newCycleTimeout())
					continue
				}

				if len(tasks) == 0 {
					{{ .Logger.InfoMsg "ctx" "no tasks to run" "str::$nameFieldLogger::WorkerName" }}
					timer = time.NewTimer(NextIterationTimeout)
					continue
				}

				MaxWorkers, ok, err := occonf.WorkerMaxWorkers(ctx, WorkerName)
				if err != nil {
					{{ .Logger.ErrorMsg "ctx" "err" "Error get max_workers config" "str::$nameFieldLogger::WorkerName" }}
				}

				if err != nil || !ok {
					MaxWorkers = 5 // default value
				}

				var wgWorkers errgroup.Group

				tasksChan := make(chan daemon.ITask)

				for i := 0; i < int(MaxWorkers); i++ {
					wgWorkers.Go(func() error {
						for task := range tasksChan {
							if err := w.JobStarter(ctx, task); err != nil {
								{{ .Logger.ErrorMsg "ctx" "err" "Error job starter" "str::$nameFieldLogger::WorkerName" "str::taskID::task.GetID(ctx)"}}
							}
						}

						return nil
					})
				}

				for _, task := range tasks {
					tasksChan <- task
				}

				close(tasksChan)

				if err := wgWorkers.Wait(); err != nil {
					{{ .Logger.ErrorMsg "ctx" "err" "Worker pool error" "str::$nameFieldLogger::WorkerName" }}
				}

				{{ .Logger.DebugMsg "ctx" "worker finished cycle" }}
				timer = time.NewTimer(NextIterationTimeout)
			case <-ctx.Done():
				break JOB
			}
		}

		{{ .Logger.InfoMsg "ctx" "worker stopped" "str::$nameFieldLogger::WorkerName" }}

		return nil
	})
}

// Shutdown — hard stop. Override OnShutdown below the marker to customize.
func (w *Worker) Shutdown(ctx context.Context) error {
	return w.OnShutdown(ctx)
}

// GracefulStop — graceful stop. Override OnGracefulStop below the marker to customize.
func (w *Worker) GracefulStop(ctx context.Context) (<-chan struct{}, error) {
	return w.OnGracefulStop(ctx)
}
