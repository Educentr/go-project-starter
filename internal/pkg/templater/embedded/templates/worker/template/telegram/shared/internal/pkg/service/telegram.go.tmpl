package service

import (
    "context"

    "github.com/pkg/errors"
    tgbotapi "github.com/OvyFlash/telegram-bot-api"

    "{{ .ProjectPath }}/pkg/drivers/telegram"
)

func (s *Service) GetUpdateChannel(ctx context.Context) tgbotapi.UpdatesChannel {
    return s.telegram.Poller
}

func (s *Service) NeedStartHiddenMessageJob(ctx context.Context) bool {
	return s.telegram.EnableHiddenMessage
}

func (s *Service) StopChannel(ctx context.Context) {
    s.telegram.StopChannel(ctx)
}

func (s *Service) TelegramGetPayments(ctx context.Context, skip, limit int64) (*tgbotapi.StarTransactions, error) {
	return s.telegram.GetPayments(ctx, skip, limit)
}

func (s *Service) TelegramAnswerCallback(ctx context.Context, callbackID string, text string) (bool, error) {
	return s.telegram.SendAnswerCallback(ctx, callbackID, text)
}

func (s *Service) TelegramUpdateMessageButtons(ctx context.Context, rd telegram.RequestData, msgID int, msg telegram.Message) (int, error) {
	err := s.telegram.EditMessageWithButton(ctx, rd, msgID, msg)
	if err != nil {
		return 0, errors.Wrap(err, "can't send message")
	}

	return msgID, nil
}

func (s *Service) TelegramSendMessageButtons(ctx context.Context, rd telegram.RequestData, msg telegram.Message) (int, error) {
	msgID, err := s.telegram.SendMessageWithButton(ctx, rd, msg)
	if err != nil {
		return 0, errors.Wrap(err, "can't send message")
	}

	return msgID, nil
}

func (s *Service) TelegramDeleteMessage(ctx context.Context, chatID int64, msgID int) error {
	return s.telegram.DeleteMessage(ctx, chatID, msgID)
}

func (s *Service) TelegramRefundPayment(ctx context.Context, TgID int64, telegramPaymentChargeID string) error {
	return s.telegram.RefundPayment(ctx, TgID, telegramPaymentChargeID)
}

func (s *Service) TelegramCheckUserInChannel(ctx context.Context, channelID, userID int64) (bool, error) {
	return s.telegram.CheckUserInChannel(ctx, channelID, userID)
}

func (s *Service) TelegramAnswerPreCheckout(ctx context.Context, channelID, text string) error {
    return s.telegram.AnswerPreCheckout(ctx, channelID, text)
}

func (s *Service) SendInvoice(ctx context.Context, chatID int64, invoice telegram.InvoiceData) (int, error) {
	return s.telegram.SendInvoice(ctx, chatID, invoice)
}

func (s *Service) GetFileDirectURL(fileID string) (string, error) {
	return s.telegram.GetFileDirectURL(fileID)
}

// TelegramPackInvoiceData упаковывает и подписывает payload инвойса.
//
// Подпись делается ключом текущего токена бота, а токен принадлежит экземпляру
// драйвера — поэтому упаковка это метод драйвера, а не функция пакета telegram, и
// добраться до неё можно только через сервис, у которого драйвер есть.
func (s *Service) TelegramPackInvoiceData(ctx context.Context, invoiceData telegram.TelegramInvoiceData) (string, error) {
	return s.telegram.PackInvoiceData(ctx, invoiceData)
}

// TelegramUnpackInvoiceData разбирает payload инвойса и проверяет его подпись.
func (s *Service) TelegramUnpackInvoiceData(ctx context.Context, invoice *telegram.TelegramInvoiceData, data string) error {
	return s.telegram.UnpackInvoiceData(ctx, invoice, data)
}

// TelegramTokenSHA отдаёт ключ подписи WebApp-данных текущего токена бота —
// HMAC("WebAppData", botToken), которым Telegram подписывает initData мини-аппа.
//
// Нужен проекту, который валидирует initData сам: вместе с
// telegram.MakeSHA256Hash это полная проверка подписи. Ключ переехал из
// package-level переменной драйвера в его поле, поэтому единственный путь к нему
// снаружи — через сервис, у которого драйвер есть.
func (s *Service) TelegramTokenSHA(ctx context.Context) ([]byte, error) {
	return s.telegram.GetTgTokenSHA(ctx)
}