package telegram

import (
	"context"
	"crypto/hmac"
	"crypto/sha256"

	{{ .Logger.Import }}

	"{{ .ProjectPath }}/{{ .OnlineConf.GetPackagePath }}"
)

// GetTgTokenPath returns the path of the bot token, for a subscription to its
// rotation. The token is a declared key, so the path comes from the accessor
// package rather than from segments assembled here.
func GetTgTokenPath(_ context.Context, _ string) string {
	return occonf.TelegramTokenPath()
}

func GetTgToken(ctx context.Context, serviceName string) (string, error) {
	botToken, _, err := occonf.TelegramToken(ctx)
	if err != nil {
		{{ $.Logger.ErrorMsg "ctx" "err" "Error getting bot_token" }}

		return "", ErrInvalidAuthConfig
	}

	if botToken == "" {
		{{ $.Logger.ErrorMsg "ctx" "nil" "tg_token is empty" }}

		return "", ErrInvalidAuthConfig
	}

	return botToken, nil
}

// tgTokenSHA считает ключ подписи WebApp-данных по токену бота.
//
// Считает, но не ставит: ключ ставит applyToken вместе с ботом этого же токена,
// одним захватом мьютекса драйвера. Прежний порядок — записать ключ, а потом
// собрать бота, который может не собраться, — оставлял ключ нового токена при
// боте прежнего до следующей удачной ротации.
//
// Ключ этот — только для WebApp-данных: их Telegram подписывает именно текущим
// токеном бота, поэтому вывод из токена здесь не недостаток, а требование.
// Подпись инвойса на него больше не опирается — у неё свой секрет, см.
// invoiceSignKey.
func tgTokenSHA(ctx context.Context, botToken string) ([]byte, error) {
	return MakeSHA256Hash(ctx, []byte("WebAppData"), []byte(botToken))
}

func MakeSHA256Hash(ctx context.Context, key, data []byte) ([]byte, error) {
	hashKey := hmac.New(sha256.New, key)

	_, err := hashKey.Write(data)
	if err != nil {
		{{ $.Logger.ErrorMsg "ctx" "err" "Error writing hash" }}

		return nil, ErrInvalidAuthConfig
	}

	return hashKey.Sum(nil), nil
}

// invoiceSignKey отдаёт ключ подписи payload инвойса и признак того, что секрет
// под него задан.
//
// Ключ не выводится из токена бота и в состоянии драйвера не живёт: он читается
// из дерева конфигурации на каждую упаковку и на каждую проверку. Пока он
// выводился из токена, подпись инвойса переживала ротацию только случайно —
// payload лежит в чате до оплаты, то есть минуты и часы, и ротация в это окно
// означала, что выпущенный инвойс перестанет проверяться ровно тогда, когда
// пользователь нажмёт «оплатить». Худший случай — ротация между
// pre_checkout_query и successful_payment: Stars списаны, а обработчик покупки
// отвечает «invalid sign» и товар не выдаёт.
//
// Отсюда и форма: у подписи свой секрет, поэтому согласованный снимок пары
// «бот и ключ» не нужен ни упаковке, ни отправке — брать его двумя захватами
// мьютекса больше нечему, и ротация токена подписи инвойса не касается вовсе.
//
// Секрет один на сервис и бота не различает: инвойс, выпущенный при одном боте,
// проверяется и после того, как в tg_token положили токен другого. Это выбор, а
// не побочный эффект — апдейты оплаты такого инвойса новому боту Telegram не
// присылает (инвойс лежит в чате с прежним), а если токен вернут прежнему боту,
// неоплаченный инвойс обязан пережить и это. Развести инвойсы ботов можно
// только сменой самого секрета — она обесценивает все выпущенные до неё.
//
// Функция пакета, а не метод: читать ей нечего, кроме дерева конфигурации, и
// состояния драйвера она не касается — в отличие от GetTgTokenSHA.
//
// Пустое значение — то же, что отсутствующее: подписать им технически можно, но
// пустой секрет не секрет, а след незаконченной настройки.
func invoiceSignKey(ctx context.Context) ([]byte, bool, error) {
	secret, ok, err := occonf.TelegramInvoiceSignKey(ctx)
	if err != nil {
		{{ $.Logger.ErrorMsg "ctx" "err" "Error getting invoice_sign_key" }}

		return nil, false, ErrInvalidAuthConfig
	}

	if !ok || secret == "" {
		return nil, false, nil
	}

	key, err := MakeSHA256Hash(ctx, []byte(invoiceSignContext), []byte(secret))
	if err != nil {
		return nil, false, err
	}

	return key, true, nil
}

// GetTgTokenSHA отдаёт ключ подписи WebApp-данных текущего токена бота.
//
// Метод, а не функция пакета: ключ живёт в драйвере (поле tgSHA), а не в
// package-level переменной. Вызывающие вне драйвера получают его через сервис
// (Service.TelegramTokenSHA).
//
// Бот этой операции не нужен, поэтому пары «ключ и бот» здесь нет и захват
// один: ключ обязан быть ключом текущего токена, потому что initData мини-аппа
// Telegram подписывает именно им.
func (tg *Telegram) GetTgTokenSHA(_ context.Context) ([]byte, error) {
	tg.mu.RLock()
	sha := tg.tgSHA
	tg.mu.RUnlock()

	if sha == nil {
		return nil, ErrTGConfiguration
	}

	return sha, nil
}
