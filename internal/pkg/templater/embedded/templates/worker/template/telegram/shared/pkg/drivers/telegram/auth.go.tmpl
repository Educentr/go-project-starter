package telegram

import (
	"context"
	"crypto/hmac"
	"crypto/sha256"

	{{ .Logger.Import }}

	"{{ .ProjectPath }}/{{ .OnlineConf.GetPackagePath }}"
)

// GetTgTokenPath returns the path of the bot token, for a subscription to its
// rotation. The token is a declared key, so the path comes from the accessor
// package rather than from segments assembled here.
func GetTgTokenPath(_ context.Context, _ string) string {
	return occonf.TelegramTokenPath()
}

func GetTgToken(ctx context.Context, serviceName string) (string, error) {
	botToken, _, err := occonf.TelegramToken(ctx)
	if err != nil {
		{{ $.Logger.ErrorMsg "ctx" "err" "Error getting bot_token" }}

		return "", ErrInvalidAuthConfig
	}

	if botToken == "" {
		{{ $.Logger.ErrorMsg "ctx" "nil" "tg_token is empty" }}

		return "", ErrInvalidAuthConfig
	}

	return botToken, nil
}

// updateTgSHA пересчитывает ключ подписи WebApp-данных по текущему токену бота.
// Зовётся из Init и из подписки на ротацию токена.
func (tg *Telegram) updateTgSHA(ctx context.Context, serviceName string) error {
	botToken, err := GetTgToken(ctx, serviceName)
	if err != nil {
		return err
	}

	sha, err := MakeSHA256Hash(ctx, []byte("WebAppData"), []byte(botToken))
	if err != nil {
		return err
	}

	// Под мьютексом: ротацию токена исполняет горутина наблюдателя OnlineConf, а
	// читает ключ подпись/проверка инвойса в горутине запроса.
	//
	// Это закрывает гонку только на tgSHA — поле, которое переехало сюда из
	// package-level переменной. Ротация в том же колбэке переписывает и tg.bot,
	// тоже без синхронизации, и это по-прежнему гонка: она не про глобальные
	// переменные, старше этой правки и требует протащить блокировку через все
	// чтения tg.bot в драйвере. Заведена отдельной задачей.
	tg.tgSHAMu.Lock()
	tg.tgSHA = sha
	tg.tgSHAMu.Unlock()

	return nil
}

func MakeSHA256Hash(ctx context.Context, key, data []byte) ([]byte, error) {
	hashKey := hmac.New(sha256.New, key)

	_, err := hashKey.Write(data)
	if err != nil {
		{{ $.Logger.ErrorMsg "ctx" "err" "Error writing hash" }}

		return nil, ErrInvalidAuthConfig
	}

	return hashKey.Sum(nil), nil
}

// GetTgTokenSHA отдаёт ключ подписи WebApp-данных текущего токена бота.
//
// Метод, а не функция пакета: ключ живёт в драйвере (поле tgSHA), а не в
// package-level переменной. Вызывающие вне драйвера получают его через сервис
// (Service.TelegramPackInvoiceData / TelegramUnpackInvoiceData).
func (tg *Telegram) GetTgTokenSHA(_ context.Context) ([]byte, error) {
	tg.tgSHAMu.RLock()
	sha := tg.tgSHA
	tg.tgSHAMu.RUnlock()

	if sha == nil {
		return nil, ErrTGConfiguration
	}

	return sha, nil
}
