type InvoiceData struct {
	ProductName        string
	ProductDescription string
	ProductPhoto       string
	ProductLink        string
	Data               string
	Price              int
}

type InvoiceProduct interface {
	Pack(w io.Writer) error
	Unpack(data *bytes.Buffer) error
}

// ToDo эта структура не относится к телеграму. Это общая структура для хранения данных о счете
// в базе данных. Она должна быть вынесена в отдельный пакет, например, "pkg/ds/invoice"
// Но пока что она здесь, потому что используется только в этом пакете.
// В будущем, когда появится необходимость использовать эту структуру в других пакетах,
// ее нужно будет вынести в отдельный пакет и использовать там.
type TelegramInvoiceData struct {
	UserID         int64
	IdempotencyKey uuid.UUID
	Products       InvoiceProduct
	Created 	   time.Time
}

type PaymentType string

const (
	PaymentTypeStars PaymentType = "stars"
)

const (
	invalidProductTypeMessage = "invalid product type"
	productIDParamName        = "productID"
)

var (
	ErrNotInitialized = errors.New("telegram bot not initialized")
)

func (tg *Telegram) SendInvoice(ctx context.Context,
	chatID int64,
	invoice InvoiceData,
) (int, error) {
	bot := tg.currentBot()
	if bot == nil {
		return 0, ErrNotInitialized
	}

	resp, err := bot.RequestWithContext(ctx, tgbotapi.NewInvoice(
		chatID,
		invoice.ProductName,
		invoice.ProductDescription,
		invoice.Data,
		"",
		invoice.ProductLink,
		currency,
		[]tgbotapi.LabeledPrice{ {Label: invoice.ProductName, Amount: invoice.Price} },
		[]int{},
	))
	if err != nil {
		return 0, err
	}

	if resp == nil {
		return 0, errors.New("no response from telegram")
	}

	if resp.ErrorCode != 0 {
		return 0, errors.New(resp.Description)
	}

	if resp.Result != nil {
		var message tgbotapi.Message

		return message.MessageID, json.Unmarshal(resp.Result, &message)
	}

	return 0, errors.New("no message found")
}

// PackInvoiceData упаковывает данные инвойса в payload и подписывает его.
//
// Ключ подписи — отдельный секрет (invoiceSignKey), а не ключ текущего токена
// бота: payload проверяется при оплате, то есть спустя минуты или часы после
// выпуска, и ключ, зависящий от токена, не переживал бы ротацию в этом окне.
// Поэтому пара «бот и его ключ» упаковке не нужна — ни одного захвата мьютекса
// драйвера здесь не осталось, и подписать ключом одного токена, а отправить
// ботом другого больше нечем.
//
// Метод, а не функция пакета: вне драйвера зовётся через сервис
// (Service.TelegramPackInvoiceData), и у соседней UnpackInvoiceData состояние
// драйвера ещё читается — переходным ключом проверки.
func (tg *Telegram) PackInvoiceData(ctx context.Context, invoiceData TelegramInvoiceData) (string, error) {
	ret := bytes.Buffer{}
	w := bufio.NewWriter(&ret)

	err := PackNumber64(w, invoiceData.UserID)
	if err != nil {
		return "", err
	}

	idempotencyByte, err := invoiceData.IdempotencyKey.MarshalBinary()
	if err != nil {
		return "", err
	}

	_, err = w.Write(idempotencyByte)
	if err != nil {
		return "", err
	}

	cr, err := invoiceData.Created.MarshalBinary()
	if err != nil {
		return "", err
	}

	err = w.WriteByte(byte(len(cr)))
	if err != nil {
		return "", err
	}

	_, err = w.Write(cr)
	if err != nil {
		return "", err
	}

	err = invoiceData.Products.Pack(w)
	if err != nil {
		return "", err
	}

	err = w.Flush()
	if err != nil {
		return "", err
	}

	key, ok, err := invoiceSignKey(ctx)
	if err != nil {
		return "", err
	}

	// Отказ, а не подпись чем-нибудь ещё: инвойс, который нельзя будет
	// проверить при оплате, — это списанные Stars без выдачи товара. Засейте
	// {service}/security/invoice_sign_key.
	if !ok {
		return "", ErrInvoiceSignKeyNotSet
	}

	sign, err := MakeSHA256Hash(ctx, key, ret.Bytes())
	if err != nil {
		return "", err
	}

	_, err = w.Write(sign[0:invoiceSignLen])
	if err != nil {
		return "", err
	}

	err = w.Flush()
	if err != nil {
		return "", err
	}

	return base64.StdEncoding.EncodeToString(ret.Bytes()), nil
}

// invoiceSignKeys отдаёт ключи, которыми проверяется подпись payload инвойса, в
// порядке проверки.
//
// Их два, и второй — переходный. Первый — секрет invoice_sign_key, которым
// подписывает PackInvoiceData. Второй — ключ текущего токена бота: им
// подписывались инвойсы, выпущенные до появления секрета, и они в этот момент
// ещё могут лежать в чатах неоплаченными. Без него обновление драйвера сразу
// отвергло бы каждый такой инвойс.
//
// Переходный ключ наследует и прежнее ограничение: инвойс, подписанный им,
// по-прежнему не переживает ротацию токена. Окно конечно — это инвойсы, выпущенные
// до засева секрета, — и закрывается оно само, поэтому ключ будет убран (см.
// DEPRECATION.md). Согласованной пары «ключ и бот» он не создаёт: проверке бот
// не нужен.
func (tg *Telegram) invoiceSignKeys(ctx context.Context) ([][]byte, error) {
	keys := make([][]byte, 0, 2)

	key, ok, err := invoiceSignKey(ctx)
	if err != nil {
		return nil, err
	}

	if ok {
		keys = append(keys, key)
	}

	if legacy, lerr := tg.GetTgTokenSHA(ctx); lerr == nil {
		keys = append(keys, legacy)
	}

	// Ни секрета, ни токена: проверять нечем, и сказать об этом надо тем же, чем
	// отказывает упаковка, — «invalid sign» увёл бы разбор на подделку payload.
	if len(keys) == 0 {
		return nil, ErrInvoiceSignKeyNotSet
	}

	return keys, nil
}

// UnpackInvoiceData разбирает payload инвойса и проверяет его подпись.
//
// Проверяется секретом invoice_sign_key — тем же, которым подписала
// PackInvoiceData, и ротация токена бота между выпуском инвойса и его оплатой на
// проверку больше не влияет. Переходный ключ прежних инвойсов — в
// invoiceSignKeys.
//
// Метод по той же причине, что PackInvoiceData; вне драйвера — через
// Service.TelegramUnpackInvoiceData.
func (tg *Telegram) UnpackInvoiceData(ctx context.Context, invoice *TelegramInvoiceData, data string) error {
	dec, err := base64.StdEncoding.DecodeString(data)
	if err != nil {
		return err
	}

	// Короче подписи — значит подписи в payload нет. Без этой проверки срез ниже
	// паникует, а payload приходит из апдейта Telegram, то есть на вход попадает
	// всё, что в этом поле окажется.
	if len(dec) < invoiceSignLen {
		return errors.New("invalid sign")
	}

	keys, err := tg.invoiceSignKeys(ctx)
	if err != nil {
		return err
	}

	sign := dec[len(dec)-invoiceSignLen:]

	dec = dec[:len(dec)-invoiceSignLen]

	signed := false

	for _, key := range keys {
		signCheck, serr := MakeSHA256Hash(ctx, key, dec)
		if serr != nil {
			return serr
		}

		// hmac.Equal, а не bytes.Equal: сравнение подписи за постоянное время не
		// отдаёт по длительности того, сколько её байт угадано.
		if hmac.Equal(sign, signCheck[0:invoiceSignLen]) {
			signed = true

			break
		}
	}

	if !signed {
		return errors.New("invalid sign")
	}

	decoder := bytes.NewBuffer(dec)

	err = UnpackNumber64(decoder, &invoice.UserID)
	if err != nil {
		return err
	}

	idempotencyByte := make([]byte, uuid.Size)

	_, err = decoder.Read(idempotencyByte)
	if err != nil {
		return err
	}

	err = invoice.IdempotencyKey.UnmarshalBinary(idempotencyByte)
	if err != nil {
		return err
	}

	lenByte, err := decoder.ReadByte()
	if err != nil {
		return err
	}

	err = invoice.Created.UnmarshalBinary(decoder.Next(int(lenByte)))
	if err != nil {
		return err
	}

	err = invoice.Products.Unpack(decoder)
	if err != nil {
		return err
	}

	if decoder.Len() != 0 {
		return errors.New("unpacked data is not empty")
	}

	return nil
}
