package telegram

import (
	"context"
	"fmt"
	stdlog "log"
	"net/http"
	"regexp"
	"time"

	"github.com/Educentr/go-onlineconf/pkg/onlineconf"
	tgbotapi "github.com/OvyFlash/telegram-bot-api"
	"github.com/Educentr/go-project-starter-runtime/pkg/ds"
	"github.com/prometheus/client_golang/prometheus"
	{{ .Logger.Import }}
	"golang.org/x/sync/errgroup"
)

// OnSendErrorCallback вызывается при ошибке отправки сообщения
type OnSendErrorCallback func(ctx context.Context, rd RequestData, err error)

type Telegram struct {
	bot                 *tgbotapi.BotAPI
	startUpdatePoller   bool
	EnableHiddenMessage bool
	Poller              tgbotapi.UpdatesChannel
	OnSendError         OnSendErrorCallback
	apiEndpoint         string
}

const (
	defaultWaitTimeout = 60
	defaultChannelSize = 100

	// defaultClientTimeout — таймаут HTTP-клиента бота. Заметно больше defaultWaitTimeout,
	// и это обязательно: длинный опрос держит запрос на стороне Telegram до
	// defaultWaitTimeout секунд, поэтому при таймауте меньше или около того каждый штатный
	// пустой ответ обрывался бы как ошибка и опрос выродился бы в цикл повторов.
	// Без таймаута вовсе зависший запрос висит вечно — отменить его некому, контекст
	// у него живёт столько же, сколько сам бот.
	defaultClientTimeout = 90 * time.Second

	// tokenRedacted — чем заменяется токен в строке лога.
	tokenRedacted = "<redacted>"
)

// Токен бота в тексте сообщения. Библиотека печатает ошибку запроса как есть, а
// net/http приводит в ней полный URL — вместе с токеном, который в этом URL и живёт:
// `Get "https://api.telegram.org/bot<токен>/getUpdates": context deadline exceeded`.
// Печатается это на каждом обрыве по таймауту и дальше на каждом повторе раз в три
// секунды, то есть боевой токен уходил бы в логи контейнера штатным следствием
// самого таймаута.
//
// Два выражения, а не одно: первое режет токен в составе URL при любом его виде,
// второе — сам токен, если эндпоинт собран без `/bot`. Оба без состояния, поэтому
// логгер ставится один раз на процесс и смена токена его не касается.
var (
	tokenInURL = regexp.MustCompile(`/bot[^/\s"]+`)
	bareToken  = regexp.MustCompile(`[0-9]{3,}:[A-Za-z0-9_-]{20,}`)
)

// botLogger — логгер библиотеки Telegram: пишет туда же, куда писал прежний
// (stderr стандартного log), но без токена в строке.
type botLogger struct {
	out *stdlog.Logger
}

func (l botLogger) Println(v ...any) {
	l.out.Print(redactToken(fmt.Sprintln(v...)))
}

func (l botLogger) Printf(format string, v ...any) {
	l.out.Print(redactToken(fmt.Sprintf(format, v...)))
}

// redactingClient — HTTPClient библиотеки, у которого ошибка транспорта приходит уже
// без токена.
//
// Подмены логгера мало: SetLogger перехватывает только то, что библиотека печатает
// сама, а ошибку `Client.Do` она отдаёт наружу как есть — вместе с URL, в котором
// живёт токен. Дальше её печатает наш zerolog при обновлении токена и при отказе
// отправки, main при провале Init, уведомление админам, — а отказ отправки админу
// ещё и уходит ему текстом сообщения в Telegram.
//
// Точка одна намеренно: каждый из этих путей берёт ошибку из этого самого Do,
// поэтому вырезание здесь закрывает их разом и не требует править ни одно место
// логирования.
type redactingClient struct {
	inner *http.Client
}

func (c redactingClient) Do(req *http.Request) (*http.Response, error) {
	resp, err := c.inner.Do(req)
	if err != nil {
		return resp, &redactedError{msg: redactToken(err.Error()), err: err}
	}

	return resp, nil
}

// redactedError — ошибка транспорта без токена в тексте. Исходную держит внутри и
// отдаёт по Unwrap: errors.Is и errors.As продолжают работать, а в лог уходит только
// вычищенный текст — логгеры зовут Error(), цепочку они не разворачивают.
type redactedError struct {
	msg string
	err error
}

func (e *redactedError) Error() string { return e.msg }

func (e *redactedError) Unwrap() error { return e.err }

// redactToken вырезает токен бота из строки лога.
func redactToken(msg string) string {
	msg = tokenInURL.ReplaceAllString(msg, "/bot"+tokenRedacted)

	return bareToken.ReplaceAllString(msg, tokenRedacted)
}

func Create(options ...Option) ds.Runnable {
	tg := &Telegram{}

	for _, opt := range options {
		opt.apply(tg)
	}

	return tg
}

func (tg *Telegram) Name() string {
	return "Telegram"
}

func (tg *Telegram) Init(ctx context.Context, serviceName string, _ ds.ServerBucket, _ *prometheus.Registry) error {
	// Логгер библиотеки подменяется один раз на процесс, а не при каждой смене
	// токена: выражения выше без состояния, а SetLogger пишет в пакетную
	// переменную — повторный вызов из живого опроса был бы гонкой. Единственная
	// ошибка, которую он возвращает, — «logger is nil».
	_ = tgbotapi.SetLogger(botLogger{out: stdlog.Default()})

	bufferSizeConfigPath := onlineconf.MakePath(serviceName, configPath, "buffer_size")

	updateTgToken := func(ctx context.Context) error {
		err := updateTgSHA(ctx, serviceName)
		if err != nil {
			return err
		}

		botToken, err := GetTgToken(ctx, serviceName)
		if err != nil {
			return err
		}

		// Get API endpoint from onlineconf or use option value
		apiEndpoint := tg.apiEndpoint
		if apiEndpoint == "" {
			apiEndpoint, _ = onlineconf.GetString(ctx, onlineconf.MakePath(serviceName, configPath, "tg_api_endpoint"), "")
		}

		if apiEndpoint == "" {
			apiEndpoint = tgbotapi.APIEndpoint
		}

		// Клиент со своим таймаутом создаётся здесь, а не подменяется в поле bot.Client
		// снаружи: объект бота пересоздаётся на каждой смене токена, и подменённый
		// однажды клиент после ротации молча вернулся бы к бестаймаутному.
		bot, err := tgbotapi.NewBotAPIWithClient(botToken, apiEndpoint, redactingClient{inner: &http.Client{Timeout: defaultClientTimeout}})
		if err != nil {
			return err
		}

		if tg.startUpdatePoller {
			bufferSize, err := onlineconf.GetInt(ctx, bufferSizeConfigPath, defaultBufferSize)
			if err != nil {
				{{ $.Logger.ErrorMsg "ctx" "err" "Error getting buffer_size" }}

				bufferSize = 0
			}

			if bufferSize < 1 {
				{{ $.Logger.ErrorMsg "ctx" "nil" "buffer_size is less than 1" "int64::buffer_size::bufferSize" }}

				bufferSize = 0
			}

			if bufferSize > defaultChannelSize {
				{{ $.Logger.ErrorMsg "ctx" "nil" "buffer_size is more than 100" "int64::buffer_size::bufferSize" }}

				bufferSize = 0
			}

			if bufferSize != 0 {
				bot.Buffer = int(bufferSize)
			}
		}

		tg.bot = bot

		return nil
	}

	err := onlineconf.RegisterSubscription(ctx, onlineconf.DefaultModule, []string{GetTgTokenPath(ctx, serviceName)},
		func() error {
			{{ $.Logger.InfoMsg "ctx" "tg_token updated" }}

			return updateTgToken(ctx)
		})

	if err != nil {
		return err
	}

	err = updateTgToken(ctx)
	if err != nil {
		{{ $.Logger.ErrorMsg "ctx" "err" "Error updating tg_token" }}

		return err
	}

	return nil
}

// Run - start transport
func (tg *Telegram) Run(_ context.Context, _ *errgroup.Group) {
	if tg.startUpdatePoller {
		config := tgbotapi.UpdateConfig{
			Timeout: defaultWaitTimeout,
		}

		tg.Poller = tg.bot.GetUpdatesChan(config)
	}
}

func (tg *Telegram) StopChannel(_ context.Context) {
	if tg.startUpdatePoller {
		tg.bot.StopReceivingUpdates()
	}
}

// ShutdownHTTP shutting down transport
func (tg *Telegram) Shutdown(ctx context.Context) error {
	tg.StopChannel(ctx)

	return nil
}

// GracefulStop do graceful stop transport
func (tg *Telegram) GracefulStop(_ context.Context) (<-chan struct{}, error) {
	stopped := make(chan struct{})
	close(stopped)

	return stopped, nil
}

func (tg *Telegram) StartUpdateListener(
	ctx context.Context,
	updateHandler func(ctx context.Context, update tgbotapi.Update) error,
) error {
	u := tgbotapi.NewUpdate(0)
	u.Timeout = 60

	updates := tg.bot.GetUpdatesChan(u)

	for update := range updates {
		if err := updateHandler(ctx, update); err != nil {
			return err
		}
	}

	return nil
}

func (tg *Telegram) CheckUserInChannel(_ context.Context, chatID int64, userID int64) (bool, error) {
	member, err := tg.bot.GetChatMember(tgbotapi.GetChatMemberConfig{
		ChatConfigWithUser: tgbotapi.ChatConfigWithUser{
			UserID: userID,
			ChatConfig: tgbotapi.ChatConfig{
				ChatID: chatID,
			},
		},
	})
	if err != nil {
		return false, err
	}

	if member.IsMember || member.Status == "creator" || member.Status == "member" {
		return true, nil
	}

	return false, nil
}
