// Package occonftest builds the context a test needs: one carrying a real
// OnlineConf tree, with the values the test declares in it.
//
// It exists because a context without a tree is not a state the service's code
// is written for. {{ .OnlineConf.GetPackageName }}.Initialize runs once at process start and the
// process exits when it fails, so every context the service ever sees carries
// the tree — which is why an accessor reads without asking first.
//
// A test on a bare context is outside that chain, and a read there does not
// answer with a default: it dereferences the instance that is not in the
// context. The answer is to put a tree in the context, not to teach every
// reader to live without one.
//
// A separate package, so that `testing` stays out of the service binary's
// import graph. Inside the accessor package's directory, because building a
// tree means calling the OnlineConf library, which `make onlineconf-validate`
// allows nowhere else.
package occonftest

import (
	"context"
	"testing"

	"github.com/Educentr/go-onlineconf/pkg/onlineconf"
	"github.com/Educentr/go-onlineconf/pkg/onlineconf_dev"
)

// Context returns a context carrying a configuration tree built from values —
// a map of full OnlineConf path to the value stored at it. Pass the path
// constants and path builders of the {{ .OnlineConf.GetPackageName }} package rather than hand-written
// strings: that is the point of the key map.
//
// Values are strings because that is what a tree holds; the typed accessors
// parse them, so declaring "11m" for a duration key and "7" for an int key is
// what the running service would read. A path the map does not mention is
// simply absent, and an absent key is a case worth testing too: the accessor of
// a key with a declared default answers with it, and the accessor of an
// optional key reports the absence.
//
// The tree is written into tb.TempDir(), so it is gone when the test is, and
// the context descends from tb.Context(). That is deliberate: a fixture that
// did not take tb would have to build a context root of its own, which is the
// very thing being removed.
//
// The environment does not reach the tree: ONLINECONFIG_FROM_ENV and the OC_*
// variables, which is how the dev stand feeds a tree, do not change what this
// answers. Only values does.
func Context(tb testing.TB, values map[string]string) context.Context {
	tb.Helper()

	dir := tb.TempDir()

	tree := make(map[string]any, len(values))
	for path, value := range values {
		tree[path] = value
	}

	// The same call the dev stand makes from ONLINECONFIG_FROM_ENV: a real CDB
	// on disk, read through the same code path as production. A fake instance
	// would answer from a map and prove nothing about the accessors.
	onlineconf_dev.GenerateCDB(dir, onlineconf.DefaultModule, tree)

	// The instance is built here instead of through {{ .OnlineConf.GetPackageName }}.Initialize, which the
	// service's main calls: Initialize rewrites TREE.cdb in its config
	// directory from the OC_* variables whenever ONLINECONFIG_FROM_ENV is set,
	// and the generated .env-<app>.example sets it on its first line. A test
	// run by a developer whose shell has that file loaded would then read the
	// environment's values — or, with no OC_* set, an empty tree — instead of
	// the ones it declared, with no error and no log line. That is the silent
	// degradation this fixture exists to make impossible, so it must not
	// depend on the environment at all. Create plus ToContext is Initialize
	// without that step; the library is called directly because this package
	// is under the path make onlineconf-validate exempts.
	return onlineconf.ToContext(tb.Context(), onlineconf.Create(onlineconf.WithConfigDir(dir)))
}
