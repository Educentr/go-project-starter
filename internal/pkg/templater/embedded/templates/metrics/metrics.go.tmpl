// Package {{ .Metrics.GetPackageName }} holds every Prometheus collector this
// service is allowed to emit, generated from the service's metrics map.
//
// The service does not declare metrics in code: it uses the variables below.
// That is the point — a metric that is not in the map has no object to emit
// through, so emitting an undeclared metric is impossible rather than merely
// discouraged. `make metrics-validate` enforces the other half of the rule:
// no metric constructors outside this package.
//
// RegisterFor wires an application's collectors into a registry. The generated
// main of an application that exposes /metrics calls it on startup; an
// application with no /metrics endpoint calls it from its own code, with its
// own registry.
{{- if .Metrics.HasGaugeSet }}
//
// A declaration of type GaugeSet is a state family: its whole set of series
// comes from one source the service installs (SetFunc) or refreshes (Set), and
// a scrape sees the set as a unit. See GaugeSet.
{{- end }}
package {{ .Metrics.GetPackageName }}

import (
	"errors"
	"fmt"
{{- if .Metrics.HasGaugeSet }}
	"sync/atomic"
{{- end }}

	"github.com/prometheus/client_golang/prometheus"
)

// ErrUnknownApp reports a name that publishes none of this service's declared
// metrics — not an application of the service, or one the map assigned nothing
// to. Registering into the wrong name would otherwise leave the registry empty
// and say nothing about why.
var ErrUnknownApp = errors.New("unknown application")
{{- if .Metrics.HasGaugeSet }}

// gaugeSetSample is what a generated sample type hands its collector: the
// values of one series' labels, in the order the map declares them, and the
// value of that series.
//
// The methods are unexported deliberately: the interface is not implementable
// outside this package, so a GaugeSet cannot be instantiated with anything but
// a sample type generated from the map.
type gaugeSetSample interface {
	labelValues() []string
	value() float64
}

// GaugeSet is the collector of a state family — a gauge family whose whole set
// of series comes from one source, replaced as a unit.
//
// A *prometheus.GaugeVec cannot express that. Saying "the series I no longer
// know about must disappear" with one means Reset() followed by a refill, and
// a refill is not instantaneous: /metrics is scraped on someone else's clock,
// so a scrape landing inside that window reads the family as gone — a hole on
// the panel and a false no-data for every rule over it. Here a scrape sees
// either the whole previous set or the whole new one, because the source is
// replaced by a single atomic store.
//
// Zero value: a family with no source yet, which collects nothing — what
// /metrics shows for a freshly registered GaugeVec too, and the reason the
// first tick does not have to race the first scrape.
type GaugeSet[S gaugeSetSample] struct {
	desc *prometheus.Desc
	src  atomic.Pointer[func() []S]
}

// SetFunc installs the source of the set. The collector calls src on every
// scrape, so src is where a family cheap enough to rebuild is built from
// scratch; a family that is not (a probe, a lock-protected registry) hands
// back the last finished result of its own tick instead. A nil src detaches
// the source, and the family collects nothing again.
//
// src runs on the scraping goroutine with no lock of this collector held: it
// must not block for long, and it must not mutate a slice it has already
// returned.
func (g *GaugeSet[S]) SetFunc(src func() []S) {
	if src == nil {
		g.src.Store(nil)

		return
	}

	g.src.Store(&src)
}

// Set publishes one finished set: the family as of now. It is SetFunc over a
// source that keeps handing this slice back, which is what a tick computing
// the whole family itself wants — and it leaves no atomic swap to be written
// at the call site, which is the part that is easy to get wrong.
//
// The slice must not be mutated after the call: a scrape may be reading it.
// Build the next set in a new slice.
func (g *GaugeSet[S]) Set(samples []S) {
	g.SetFunc(func() []S { return samples })
}

// Describe sends the family's single descriptor. It is what makes a registry
// reject a second collector claiming the same metric name.
func (g *GaugeSet[S]) Describe(ch chan<- *prometheus.Desc) {
	ch <- g.desc
}

// Collect emits the current set. A series the source no longer reports is not
// emitted — that is the point of a state family: a series nobody knows about
// any more has to disappear, not freeze at its last value.
//
// A sample the descriptor refuses is reported to the registry as an invalid
// metric instead of taking the process down: the set comes from service code,
// and a scrape is not a place to panic from. The generated sample types make
// the usual cause — the wrong number of label values — impossible to write, so
// what is left here is a value Prometheus rejects.
func (g *GaugeSet[S]) Collect(ch chan<- prometheus.Metric) {
	src := g.src.Load()
	if src == nil {
		return
	}

	for _, sample := range (*src)() {
		metric, err := prometheus.NewConstMetric(g.desc, prometheus.GaugeValue, sample.value(), sample.labelValues()...)
		if err != nil {
			ch <- prometheus.NewInvalidMetric(g.desc, err)

			continue
		}

		ch <- metric
	}
}
{{- end }}

{{- range $_, $m := .Metrics.Generated }}
{{- if $m.IsGaugeSet }}

// {{ $m.SampleTypeName }} is one series of {{ $m.Name }}: the values of its
// labels plus the value of the series.
type {{ $m.SampleTypeName }} struct {
{{- range $_, $f := $m.SampleFields }}
	// {{ $f.Name }} is the value of the {{ $f.Label }} label.
	{{ $f.Name }} string
{{- end }}
	// {{ $m.ValueField }} is the value of the series.
	{{ $m.ValueField }} float64
}

func (s {{ $m.SampleTypeName }}) labelValues() []string {
	return []string{ {{- range $i, $f := $m.SampleFields }}{{ if $i }}, {{ end }}s.{{ $f.Name }}{{ end -}} }
}

func (s {{ $m.SampleTypeName }}) value() float64 {
	return s.{{ $m.ValueField }}
}

// {{ $m.SourceTypeName }} is the source of the {{ $m.Name }} set: it returns
// the whole family as of the moment it is called, and a series it leaves out
// stops being exported.
type {{ $m.SourceTypeName }} func() []{{ $m.SampleTypeName }}

// {{ $m.VarName }} — {{ $m.Help | GoComment }}
//
// Metric: {{ $m.Name }} ({{ $m.Type }}){{ if $m.Labels }}, labels: {{ range $i, $l := $m.Labels }}{{ if $i }}, {{ end }}{{ $l }}{{ end }}{{ end }}
//
// State family: install the source with {{ $m.VarName }}.SetFunc, or publish a
// finished set with {{ $m.VarName }}.Set. Until one of the two is called the
// family exports nothing.
//
//nolint:gochecknoglobals // коллектор процессный по устройству Prometheus: его регистрируют один раз и эмитят из любого места сервиса
var {{ $m.VarName }} = &{{ $m.SetType }}{
	desc: prometheus.NewDesc(
		"{{ $m.Name }}",
		{{ $m.Help | GoQuote }},
		{{ $m.LabelsLiteral }},
		nil,
	),
}
{{- else }}

// {{ $m.VarName }} — {{ $m.Help | GoComment }}
//
// Metric: {{ $m.Name }} ({{ $m.Type }}){{ if $m.Labels }}, labels: {{ range $i, $l := $m.Labels }}{{ if $i }}, {{ end }}{{ $l }}{{ end }}{{ end }}
//
//nolint:gochecknoglobals // коллектор процессный по устройству Prometheus: его регистрируют один раз и эмитят из любого места сервиса
var {{ $m.VarName }} = {{ $m.Constructor }}(
	{{ $m.OptsType }}{
		Name: "{{ $m.Name }}",
		Help: {{ $m.Help | GoQuote }},
{{- if $m.BucketsLiteral }}
		Buckets: {{ $m.BucketsLiteral }},
{{- end }}
{{- if $m.ObjectivesLiteral }}
		Objectives: {{ $m.ObjectivesLiteral }},
{{- end }}
	},
{{- if $m.LabelsLiteral }}
	{{ $m.LabelsLiteral }},
{{- end }}
)
{{- end }}
{{- end }}

// collectorsByApp holds, for each application that publishes collectors, the
// ones that application publishes — in declaration order.
//
// The split comes from the `apps` field of the metrics map. The map declares
// the surface of the SERVICE, and a service can be several processes: a
// collector registered in a process that never increments it puts an
// always-zero series on /metrics, which is indistinguishable from a broken
// feature. A declaration that names no application is published by every
// application with a /metrics endpoint, so a single-application service sees
// exactly one entry holding everything.
//
// An application with no /metrics endpoint is a key here only when the map
// names it: it has no endpoint of its own, so it is here to take its
// collectors into a registry of its own code.
//
//nolint:gochecknoglobals // таблица, целиком сгенерированная из карты метрик; после инициализации только читается
var collectorsByApp = map[string][]prometheus.Collector{
{{- range $_, $a := .Metrics.CollectorsByApp }}
	{{ $a.App | GoQuote }}: {
	{{- range $_, $m := $a.Metrics }}
		{{ $m.VarName }},
	{{- end }}
	},
{{- end }}
}

// Collectors returns every generated collector of the service, in declaration
// order — every application's, not one application's. Use CollectorsFor to
// register; this is for tooling that needs the whole surface at once.
func Collectors() []prometheus.Collector {
	return []prometheus.Collector{
{{- range $_, $m := .Metrics.Generated }}
		{{ $m.VarName }},
{{- end }}
	}
}

// CollectorsFor returns the collectors the named application publishes, or
// false when the name publishes none of this service's declared metrics.
func CollectorsFor(app string) ([]prometheus.Collector, bool) {
	collectors, ok := collectorsByApp[app]

	return collectors, ok
}

// RegisterFor registers the named application's collectors with reg.
//
// The registerer is explicit rather than the client_golang default one: tests
// need a throwaway registry, and several applications can share one binary. A
// nil registerer is a no-op; an unknown application is not, because leaving a
// registry empty over a typo is the failure this split exists to avoid.
func RegisterFor(app string, reg prometheus.Registerer) error {
	collectors, ok := CollectorsFor(app)
	if !ok {
		return fmt.Errorf("%w: %q", ErrUnknownApp, app)
	}

	if reg == nil {
		return nil
	}

	for _, collector := range collectors {
		if err := reg.Register(collector); err != nil {
			return fmt.Errorf("register metrics collector: %w", err)
		}
	}

	return nil
}

// Register registers every collector of the service with reg, ignoring the
// per-application split. It is here for a test or a tool that wants the whole
// surface in one registry; a generated main calls RegisterFor.
func Register(reg prometheus.Registerer) error {
	if reg == nil {
		return nil
	}

	for _, collector := range Collectors() {
		if err := reg.Register(collector); err != nil {
			return fmt.Errorf("register metrics collector: %w", err)
		}
	}

	return nil
}

// Unregister removes every generated collector from reg. Useful in tests that
// build and tear down a registry per case.
func Unregister(reg prometheus.Registerer) {
	if reg == nil {
		return
	}

	for _, collector := range Collectors() {
		reg.Unregister(collector)
	}
}
