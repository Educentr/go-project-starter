// OnlineConfConfigProvider implements rest.ServerConfigProvider,
// rest.HandlerTimeoutProvider, and rest.SecurityConfigProvider
// using OnlineConf for dynamic configuration.
//
// Every read goes through {{ .OnlineConf.GetPackageName }}, the generated
// accessor package: the keys below are declared in
// config_oc.go.tmpl.ockeys.yaml, and `make onlineconf-validate` is what keeps
// this file from growing a read that is not.
type OnlineConfConfigProvider struct {
	// ServiceName is the service the provider configures. The declared paths
	// carry the service tree, so the accessors no longer need it; it stays
	// because the runtime constructs the provider with it and the name is part
	// of what the provider is.
	ServiceName string
}

func NewOnlineConfConfigProvider(serviceName string) *OnlineConfConfigProvider {
	return &OnlineConfConfigProvider{ServiceName: serviceName}
}

// --- ServerConfigProvider ---

// GetServerConfig reads server configuration from OnlineConf.
//
// Every value has two declared forms — under the application name and without
// it — and is resolved application-first, transport-second. The two forms are
// two keys, so each is read through its own accessor; the order they are tried
// in is this provider's and stays here.
func (p *OnlineConfConfigProvider) GetServerConfig(ctx context.Context, serverName, appName string) (rest.ServerConfig, error) {
	ip := rest.DefaultListenIP

	if v, ok, err := occonf.RESTServerAppIP(ctx, serverName, appName); err != nil {
		{{ .Logger.ErrorMsg "ctx" "err" "error getting ip from onlineconf" "str::Default::rest.DefaultListenIP" }}
	} else if ok {
		ip = v
	} else if v, ok, err := occonf.RESTServerIP(ctx, serverName); err != nil {
		{{ .Logger.ErrorMsg "ctx" "err" "error getting ip from onlineconf" "str::Default::rest.DefaultListenIP" }}
	} else if ok {
		ip = v
	}

	port, ok, err := occonf.RESTServerAppPort(ctx, serverName, appName)
	if err != nil {
		return rest.ServerConfig{}, err
	}

	if !ok {
		port, ok, err = occonf.RESTServerPort(ctx, serverName)
		if err != nil {
			return rest.ServerConfig{}, err
		}
	}

	if !ok {
		return rest.ServerConfig{}, fmt.Errorf("required config %q not found in %s/%s", "port", serverName, appName)
	}

	timeoutRead := rest.DefaultHTTPReadTimeout

	if v, ok, err := occonf.RESTServerAppTimeoutRead(ctx, serverName, appName); err != nil {
		{{ .Logger.ErrorMsg "ctx" "err" "error getting server/timeout/read" "str::Default::rest.DefaultHTTPReadTimeout.String()" }}
	} else if ok {
		timeoutRead = v
	} else if v, ok, err := occonf.RESTServerTimeoutRead(ctx, serverName); err != nil {
		{{ .Logger.ErrorMsg "ctx" "err" "error getting server/timeout/read" "str::Default::rest.DefaultHTTPReadTimeout.String()" }}
	} else if ok {
		timeoutRead = v
	}

	timeoutWrite := rest.DefaultHTTPWriteTimeout

	if v, ok, err := occonf.RESTServerAppTimeoutWrite(ctx, serverName, appName); err != nil {
		{{ .Logger.ErrorMsg "ctx" "err" "error getting server/timeout/write" "str::Default::rest.DefaultHTTPWriteTimeout.String()" }}
	} else if ok {
		timeoutWrite = v
	} else if v, ok, err := occonf.RESTServerTimeoutWrite(ctx, serverName); err != nil {
		{{ .Logger.ErrorMsg "ctx" "err" "error getting server/timeout/write" "str::Default::rest.DefaultHTTPWriteTimeout.String()" }}
	} else if ok {
		timeoutWrite = v
	}

	// The header timeout falls back to the request read timeout, not to a
	// constant: a header read that outlives the request it belongs to is not a
	// configuration anyone wants.
	headerTimeout := timeoutRead

	if v, ok, err := occonf.RESTServerAppTimeoutReadHeader(ctx, serverName, appName); err != nil {
		{{ .Logger.ErrorMsg "ctx" "err" "error getting server/timeout/read_header. Set to server/timeout/read" }}
	} else if ok {
		headerTimeout = v
	} else if v, ok, err := occonf.RESTServerTimeoutReadHeader(ctx, serverName); err != nil {
		{{ .Logger.ErrorMsg "ctx" "err" "error getting server/timeout/read_header. Set to server/timeout/read" }}
	} else if ok {
		headerTimeout = v
	}

	return rest.ServerConfig{
		IP:                ip,
		Port:              port,
		ReadTimeout:       timeoutRead,
		WriteTimeout:      timeoutWrite,
		ReadHeaderTimeout: headerTimeout,
	}, nil
}

// SubscribeTimeoutChanges registers OnlineConf subscription for timeout changes.
// TODO: simplify to subtree subscription when go-onlineconf#2 is implemented
func (p *OnlineConfConfigProvider) SubscribeTimeoutChanges(ctx context.Context, serverName, appName string, callback func()) error {
	timeoutPaths := []string{
		occonf.RESTServerAppTimeoutReadPath(serverName, appName),
		occonf.RESTServerTimeoutReadPath(serverName),
		occonf.RESTServerAppTimeoutWritePath(serverName, appName),
		occonf.RESTServerTimeoutWritePath(serverName),
		occonf.RESTServerAppTimeoutReadHeaderPath(serverName, appName),
		occonf.RESTServerTimeoutReadHeaderPath(serverName),
	}

	return occonf.Subscribe(ctx, timeoutPaths, func() error {
		callback()
		return nil
	})
}

// --- HandlerTimeoutProvider ---

// ResolveHandlerTimeout resolves handler timeout using 4-level OnlineConf fallback:
// 1. Per-path app-specific: /{svc}/transport/rest/{transport}/{app}/handler/{urlPath}/timeout
// 2. Per-path transport-level: /{svc}/transport/rest/{transport}/handler/{urlPath}/timeout
// 3. Default app-specific: /{svc}/transport/rest/{transport}/{app}/handler/default/timeout
// 4. Default transport-level: /{svc}/transport/rest/{transport}/handler/default/timeout
// If none configured, returns 0 (no timeout).
// The four reads are spelled out rather than put in a table of closures: this
// runs on every request, and a slice of closures would allocate on each one —
// and build all four paths eagerly, where the usual answer comes from the
// first.
func (p *OnlineConfConfigProvider) ResolveHandlerTimeout(ctx context.Context, transportName, appName, pathKey string) time.Duration {
	if t, ex, err := occonf.RESTAppHandlerTimeout(ctx, transportName, appName, pathKey); err != nil {
		path := occonf.RESTAppHandlerTimeoutPath(transportName, appName, pathKey)
		{{ .Logger.ErrorMsg "ctx" "err" "error resolving handler timeout" "str::path::path" }}
	} else if ex {
		return t
	}

	if t, ex, err := occonf.RESTHandlerTimeout(ctx, transportName, pathKey); err != nil {
		path := occonf.RESTHandlerTimeoutPath(transportName, pathKey)
		{{ .Logger.ErrorMsg "ctx" "err" "error resolving handler timeout" "str::path::path" }}
	} else if ex {
		return t
	}

	if t, ex, err := occonf.RESTAppHandlerDefaultTimeout(ctx, transportName, appName); err != nil {
		path := occonf.RESTAppHandlerDefaultTimeoutPath(transportName, appName)
		{{ .Logger.ErrorMsg "ctx" "err" "error resolving handler timeout" "str::path::path" }}
	} else if ex {
		return t
	}

	if t, ex, err := occonf.RESTHandlerDefaultTimeout(ctx, transportName); err != nil {
		path := occonf.RESTHandlerDefaultTimeoutPath(transportName)
		{{ .Logger.ErrorMsg "ctx" "err" "error resolving handler timeout" "str::path::path" }}
	} else if ex {
		return t
	}

	return 0
}

// --- SecurityConfigProvider ---

// IsHTTPAuthEnabled reads httpAuth toggle from OnlineConf.
func (p *OnlineConfConfigProvider) IsHTTPAuthEnabled(ctx context.Context) (bool, error) {
	enabled, ok, err := occonf.SecurityHTTPAuthEnabled(ctx)
	if err != nil || !ok {
		// Authentication stays on unless the tree says otherwise: the fallback
		// of a security toggle is the safe answer, including when the read
		// fails.
		return true, err
	}

	return enabled, nil
}

// IsCSRFEnabled reads CSRF toggle from OnlineConf.
func (p *OnlineConfConfigProvider) IsCSRFEnabled(ctx context.Context) (bool, error) {
	enabled, ok, err := occonf.SecurityCSRFEnabled(ctx)
	if err != nil || !ok {
		return false, err
	}

	return enabled, nil
}

// GetCORSOptions reads CORS configuration from OnlineConf.
// OC path: /{project}/security/cors/{allow_all,origins,methods,headers}
// If allow_all is true, returns permissive CORS (for dev environments).
// If allow_all is false (default), reads origins, methods, headers.
// If no origins configured, rs/cors defaults apply (restrictive, for production).
func (p *OnlineConfConfigProvider) GetCORSOptions(ctx context.Context) cors.Options {
	allowAll, _, err := occonf.SecurityCORSAllowAll(ctx)
	if err != nil {
		{{ .Logger.ErrorMsg "ctx" "err" "error getting CORS allow_all from onlineconf" }}
	}

	if allowAll {
		return cors.Options{
			AllowedOrigins:   []string{"*"},
			AllowedMethods:   []string{http.MethodHead, http.MethodGet, http.MethodPost, http.MethodPut, http.MethodPatch, http.MethodDelete},
			AllowedHeaders:   []string{"*"},
			AllowCredentials: false,
		}
	}

	origins, _, err := occonf.SecurityCORSOrigins(ctx)
	if err != nil {
		{{ .Logger.ErrorMsg "ctx" "err" "error getting CORS origins from onlineconf" }}
	}

	methods, _, err := occonf.SecurityCORSMethods(ctx)
	if err != nil {
		{{ .Logger.ErrorMsg "ctx" "err" "error getting CORS methods from onlineconf" }}
	}

	headers, _, err := occonf.SecurityCORSHeaders(ctx)
	if err != nil {
		{{ .Logger.ErrorMsg "ctx" "err" "error getting CORS headers from onlineconf" }}
	}

	return cors.Options{
		AllowedOrigins: origins,
		AllowedMethods: methods,
		AllowedHeaders: headers,
	}
}

// --- Middleware helpers ---

// TransportConfigPath returns the OnlineConf path for transport handler configuration.
func (p *OnlineConfConfigProvider) TransportConfigPath(transportName, appName string) string {
	return occonf.RESTAppHandlerPath(transportName, appName)
}

// NewHitInfoContextCreator creates a HitInfoContextCreator for the given transport params.
func (p *OnlineConfConfigProvider) NewHitInfoContextCreator(transportName, appName string) mw.HitInfoContextCreator {
	return &onlineConfHitInfoContextCreator{
		transportName: transportName,
		appName:       appName,
	}
}

type onlineConfHitInfoContextCreator struct {
	transportName string
	appName       string
}

func (c *onlineConfHitInfoContextCreator) CreateHitInfoContext(requestCtx, appCtx context.Context, urlPath string) (context.Context, context.CancelFunc, error) {
	// Timeout inherited from parent request context — no additional timeout needed
	mwCtx, cancel, err := reqctx.CreateContextWithTimeout(requestCtx, appCtx, 0)
	if err != nil {
		return nil, nil, err
	}

	ocPrefix := occonf.RESTAppMetricsPath(c.transportName, c.appName)
	{{ .Logger.ReWrap "requestCtx" "mwCtx" "ocPrefix" "urlPath" }}

	return mwCtx, cancel, nil
}
