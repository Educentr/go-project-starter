package {{ .Transport.Name }}

import (
	"context"

	"github.com/pkg/errors"
    
	{{/* Import only the ogen package, like client.go does. Transport.Import
	     also carries this very wrapper package (the app layer needs both),
	     and emitting it here is a self-import — an import cycle. */}}
	{{ .Transport.PkgName }} "{{ .ProjectPath }}/pkg/rest/{{ .Transport.Name }}/{{ .Transport.ApiVersion }}"
	"{{ .ProjectPath }}/{{ .OnlineConf.GetPackagePath }}"
)

{{ if and (eq .Transport.AuthParams.Transport "header") (eq .Transport.AuthParams.Type "apikey") }}
type SecuritySource struct {}

func (ak *SecuritySource) AuthHeader(ctx context.Context, operationName {{ .Transport.PkgName }}.OperationName) ({{ .Transport.PkgName }}.AuthHeader, error) {
    key, _, err := occonf.RESTClientAPIKey(ctx, "{{ .Transport.PkgName }}")
    if err != nil {
        return {{ .Transport.PkgName }}.AuthHeader{}, errors.Wrap(err, "error getting API key")
    }

    if key == "" {
        return {{ .Transport.PkgName }}.AuthHeader{}, errors.New("API key not set")
    }


    return {{ .Transport.PkgName }}.AuthHeader{
        APIKey: key,
        Roles:  []string{"default"}, // You can modify this to include specific roles if needed
    }, nil
}
{{ else if and (eq .Transport.AuthParams.Transport "header") (eq .Transport.AuthParams.Type "bearer") }}
type SecuritySource struct {}

func (s *SecuritySource) BearerAuth(ctx context.Context, operationName {{ .Transport.PkgName }}.OperationName) ({{ .Transport.PkgName }}.BearerAuth, error) {
    token, _, err := occonf.RESTClientToken(ctx, "{{ .Transport.PkgName }}")
    if err != nil {
        return {{ .Transport.PkgName }}.BearerAuth{}, errors.Wrap(err, "error getting Bearer token")
    }

    if token == "" {
        return {{ .Transport.PkgName }}.BearerAuth{}, errors.New("Bearer token not set")
    }

    return {{ .Transport.PkgName }}.BearerAuth{
        Token: token,
    }, nil
}
{{ else if and (eq .Transport.AuthParams.Transport "header") (eq .Transport.AuthParams.Type "basic") }}
type SecuritySource struct {}

func (s *SecuritySource) BasicAuth(ctx context.Context, operationName {{ .Transport.PkgName }}.OperationName) ({{ .Transport.PkgName }}.BasicAuth, error) {
    username, _, err := occonf.RESTClientUsername(ctx, "{{ .Transport.PkgName }}")
    if err != nil {
        return {{ .Transport.PkgName }}.BasicAuth{}, errors.Wrap(err, "error getting Basic auth username")
    }

    if username == "" {
        return {{ .Transport.PkgName }}.BasicAuth{}, errors.New("Basic auth username not set")
    }

    // An absent password node is accepted on purpose, and so is an empty
    // value: APIs that carry the secret in the username use an empty password.
    password, _, err := occonf.RESTClientPassword(ctx, "{{ .Transport.PkgName }}")
    if err != nil {
        return {{ .Transport.PkgName }}.BasicAuth{}, errors.Wrap(err, "error getting Basic auth password")
    }

    return {{ .Transport.PkgName }}.BasicAuth{
        Username: username,
        Password: password,
    }, nil
}
{{ else if and .Transport.AuthParams.Type (ne .Transport.AuthParams.Type "") }}
    {{- errorf "Unsupported auth type: %s" .Transport.AuthParams.Type -}}
{{- end }}
