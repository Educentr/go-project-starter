// Register adds a command to the handler
func (h *Handler) Register(cmd *Command) {
	h.commands[cmd.Name] = cmd
}

// isHelpArg reports whether arg asks for help instead of command execution.
func isHelpArg(arg string) bool {
	switch arg {
	case "-h", "-help", "--help":
		return true
	default:
		return false
	}
}

// Execute runs the specified command with arguments.
// A leading --help/-h (after the command, or after the subcommand) prints the
// detailed help for that command instead of running it.
func (h *Handler) Execute(ctx context.Context, command string, args []string) error {
	cmd, exists := h.commands[command]
	if !exists {
		return fmt.Errorf("unknown command: %s\nRun 'help' to see available commands", command)
	}

	if len(args) > 0 && isHelpArg(args[0]) {
		return h.PrintCommandHelp(h.out, command)
	}
{{ if .CLI.Commands }}
	if cmd.Subcommands != nil {
		if len(args) == 0 {
			return fmt.Errorf("command '%s' requires a subcommand: %s", command, strings.Join(subcommandNames(cmd), ", "))
		}

		sub, exists := cmd.Subcommands[args[0]]
		if !exists {
			return fmt.Errorf("unknown subcommand '%s %s'\nAvailable: %s", command, args[0], strings.Join(subcommandNames(cmd), ", "))
		}

		if len(args) > 1 && isHelpArg(args[1]) {
			return h.PrintSubcommandHelp(h.out, command, sub.Name)
		}

		return sub.Run(ctx, args[1:])
	}
{{ end }}
	return cmd.Run(ctx, args)
}
{{ if .CLI.Commands }}
// subcommandNames returns the command's subcommand names in stable order.
func subcommandNames(cmd *Command) []string {
	names := make([]string, 0, len(cmd.Subcommands))
	for name := range cmd.Subcommands {
		names = append(names, name)
	}

	sort.Strings(names)

	return names
}
{{ end }}
// maxSummaryLen is the width budget for a description in the aligned command
// list. Longer summaries are truncated on a word boundary.
const maxSummaryLen = 70

// helpSummary returns a single-line summary of a command description, for use
// in the aligned command list where a full multi-line or long description
// would break the layout. Multi-line descriptions are cut at the first
// newline; a remaining line longer than maxSummaryLen is truncated on a word
// boundary and marked with an ellipsis.
// The full description stays available via 'help <command>' and '<command> --help'.
func helpSummary(desc string) string {
	if idx := strings.IndexByte(desc, '\n'); idx >= 0 {
		desc = desc[:idx]
	}

	desc = strings.TrimSpace(desc)

	if len(desc) <= maxSummaryLen {
		return desc
	}

	cut := desc[:maxSummaryLen]
	if idx := strings.LastIndexByte(cut, ' '); idx > 0 {
		cut = cut[:idx]
	}

	return strings.TrimRight(cut, " ,.;:") + "…"
}

// PrintHelp prints the list of available commands with a one-line summary each.
func (h *Handler) PrintHelp(w io.Writer) {
	names := make([]string, 0, len(h.commands))
	for name := range h.commands {
		names = append(names, name)
	}

	sort.Strings(names)

	fmt.Fprintln(w, "Available commands:")

	for _, name := range names {
		cmd := h.commands[name]
		fmt.Fprintf(w, "  %-15s %s\n", name, helpSummary(cmd.Description))
{{ if .CLI.Commands }}		if cmd.Subcommands != nil {
			for _, sn := range subcommandNames(cmd) {
				fmt.Fprintf(w, "    %-13s %s\n", sn, helpSummary(cmd.Subcommands[sn].Description))
			}
		}
{{ end }}	}

	fmt.Fprintln(w, "\nRun '<command> --help' for more information about a command.")
}

// printFlags prints the flag reference block of a command, if it has flags.
func printFlags(w io.Writer, flags []FlagInfo) {
	if len(flags) == 0 {
		return
	}

	fmt.Fprintln(w, "\nFlags:")

	for _, f := range flags {
		fmt.Fprintf(w, "  %-24s %s", "--"+f.Name+" "+f.Type, f.Description)

		switch {
		case f.Required:
			fmt.Fprint(w, " (required)")
		case f.Default != "":
			fmt.Fprintf(w, " (default %s)", f.Default)
		}

		fmt.Fprintln(w)
	}
}

// PrintCommandHelp prints the detailed help of a single command: its full
// description, usage and flags{{ if .CLI.Commands }}, plus the list of its subcommands{{ end }}.
func (h *Handler) PrintCommandHelp(w io.Writer, cmdName string) error {
	cmd, exists := h.commands[cmdName]
	if !exists {
		return fmt.Errorf("unknown command: %s", cmdName)
	}

	fmt.Fprintf(w, "Command: %s\n", cmd.Name)

	if cmd.Description != "" {
		fmt.Fprintf(w, "Description: %s\n", cmd.Description)
	}

	if cmd.Usage != "" {
		fmt.Fprintf(w, "Usage: %s\n", cmd.Usage)
	}

	printFlags(w, cmd.Flags)
{{ if .CLI.Commands }}
	if cmd.Subcommands != nil {
		fmt.Fprintln(w, "\nSubcommands:")

		for _, sn := range subcommandNames(cmd) {
			fmt.Fprintf(w, "  %-15s %s\n", sn, helpSummary(cmd.Subcommands[sn].Description))
		}

		fmt.Fprintf(w, "\nRun '%s <subcommand> --help' for the full subcommand description.\n", cmd.Name)
	}
{{ end }}
	return nil
}
{{ if .CLI.Commands }}
// PrintSubcommandHelp prints the detailed help of a subcommand: its full
// description, usage and flags.
func (h *Handler) PrintSubcommandHelp(w io.Writer, cmdName, subName string) error {
	cmd, exists := h.commands[cmdName]
	if !exists {
		return fmt.Errorf("unknown command: %s", cmdName)
	}

	if cmd.Subcommands == nil {
		return fmt.Errorf("command '%s' has no subcommands", cmdName)
	}

	sub, exists := cmd.Subcommands[subName]
	if !exists {
		return fmt.Errorf("unknown subcommand '%s %s'\nAvailable: %s", cmdName, subName, strings.Join(subcommandNames(cmd), ", "))
	}

	fmt.Fprintf(w, "Command: %s %s\n", cmd.Name, sub.Name)

	if sub.Description != "" {
		fmt.Fprintf(w, "Description: %s\n", sub.Description)
	}

	if sub.Usage != "" {
		fmt.Fprintf(w, "Usage: %s\n", sub.Usage)
	}

	printFlags(w, sub.Flags)

	return nil
}
