// FlagInfo describes a single flag of a command for help output.
// It mirrors the flag declared on the command's flag.FlagSet, so that detailed
// help can list flags without parsing anything.
type FlagInfo struct {
	Name        string
	Type        string
	Default     string
	Description string
	Required    bool
}

// Command represents a top-level CLI command
type Command struct {
	Name        string
	Description string
	Usage       string
	Flags       []FlagInfo
	Run         func(ctx context.Context, args []string) error
{{ if .CLI.Commands }}	Subcommands map[string]*Subcommand
{{ end }}}
{{ if .CLI.Commands }}
// Subcommand represents a subcommand within a CLI command
type Subcommand struct {
	Name        string
	Description string
	Usage       string
	Flags       []FlagInfo
	Run         func(ctx context.Context, args []string) error
}
{{ end }}
// Handler implements CLI command handling.
// CLI works like a shell: first argument is command, rest are arguments.
// Example: ./app user create --email admin@example.com
type Handler struct {
{{ if .CLI.Commands }}	UnimplementedCLI
{{ end }}	srv      ds.IService
	out      io.Writer
	commands map[string]*Command
}

// NewHandler creates a new CLI handler
func NewHandler(srv ds.IService) *Handler {
	h := &Handler{
		srv:      srv,
		out:      os.Stdout,
		commands: make(map[string]*Command),
	}

	// Register built-in commands
	h.registerBuiltinCommands()

	// Register application commands
	h.registerCommands()

	return h
}

// SetOutput redirects the handler's help and version output to w.
// Defaults to os.Stdout.
func (h *Handler) SetOutput(w io.Writer) {
	h.out = w
}

// registerBuiltinCommands registers help and version commands
func (h *Handler) registerBuiltinCommands() {
	h.Register(&Command{
		Name:        "help",
		Description: "Show help information",
{{ if .CLI.Commands }}		Usage:       "help [command [subcommand]]",
{{ else }}		Usage:       "help [command]",
{{ end }}		Run: func(ctx context.Context, args []string) error {
			switch {
			case len(args) == 0:
				h.PrintHelp(h.out)

				return nil
{{ if .CLI.Commands }}			case len(args) == 1:
				return h.PrintCommandHelp(h.out, args[0])
			default:
				return h.PrintSubcommandHelp(h.out, args[0], args[1])
{{ else }}			default:
				return h.PrintCommandHelp(h.out, args[0])
{{ end }}			}
		},
	})

	h.Register(&Command{
		Name:        "version",
		Description: "Show version information",
		Usage:       "version",
		Run: func(ctx context.Context, args []string) error {
			fmt.Fprintln(h.out, "{{ .ProjectName }} CLI")

			return nil
		},
	})
}
