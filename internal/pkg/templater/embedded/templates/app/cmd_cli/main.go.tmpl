package main

import (
	"context"
	"fmt"
	"log"
	"os"

	"github.com/joho/godotenv"
	{{ .Logger.Import }}
	{{ if .Application.UseActiveRecord }}
	"github.com/Educentr/go-activerecord/v3/pkg/activerecord"
	arlogger "github.com/Educentr/go-activerecord/v3/pkg/logger"
	"github.com/Educentr/go-activerecord/v3/pkg/logger/arzlog"
	{{- end }}

	"{{ .ProjectPath }}/internal/app/constant"
	{{ range $_, $drv := .Application.Drivers }}
	{{ $drv.Package }} "{{ $drv.Import }}"
	{{ end }}
	{{- /* Client wrappers this CLI calls. Only the wrapper is constructed here
	       (<name>.NewClient()), so WrapperImport is taken instead of the whole
	       Import list, which would add an unused ogen package alias. */ -}}
	{{ range $_, $tr := .Application.GetStaticOgenClients }}
	{{ $tr.WrapperImport }}
	{{- end }}
	"{{ .ProjectPath }}/internal/pkg/service"
	"{{ .ProjectPath }}/{{ .OnlineConf.GetPackagePath }}"
	"{{ .ProjectPath }}/pkg/app/logger"
	{{- if .Application.GetStaticOgenClients }}
	"github.com/Educentr/go-project-starter-runtime/pkg/ds"
	{{- end }}
	{{ .Application.CLI.Import }}
)

const (
	ExitCodeOK = iota
	ExitCodeErrorConfig
	ExitCodeErrorDriver
	ExitCodeErrorService
	ExitCodeErrorRun
	// ExitCodeErrorEarlyInit — отказ ранней точки расширения (earlyInit).
	// Добавлен в конец блока намеренно: коды выше — наблюдаемый контракт
	// команды, на который смотрят вызывающие её скрипты, а вставка в середину
	// блока с iota перенумеровала бы их.
	ExitCodeErrorEarlyInit
)

const (
	envFileName            = ".env"
	defaultOnlineconfDir   = "etc/onlineconf"
	onlineconfDirEnvVar    = "ONLINECONF_DIR"
)

// ldflags
var (
	Version     string
	BuildTime   string
	BuildOS     string
	BuildCommit string
)

// EmptyEarlyInit несёт реализацию earlyInit по умолчанию. Отдельный встроенный
// тип, а не метод на UserEarlyInit: метод с тем же именем, объявленный проектом
// на *UserEarlyInit ниже disclaimer-маркера (или в своём файле пакета main),
// перекрывает промотированный — именно это и делает точку расширения
// необязательной.
type EmptyEarlyInit struct{}

// earlyInit — самая ранняя точка расширения процесса. По умолчанию не делает
// ничего; проект объявляет
//
//	func (u *UserEarlyInit) earlyInit() error { ... }
//
// ниже disclaimer-маркера или в своём файле пакета main.
//
// Вызывается после загрузки .env и до occonf.Initialize — то есть до того, как
// собрано дерево конфигурации, поднят логгер и разобрана команда. Отсюда проект
// меняет окружение, из которого Initialize строит дерево, делает re-exec
// процесса, проверяет os.Args до разбора команды, перенаправляет stdout команд,
// чей вывод — машиночитаемый контракт. Порядок нескольких таких действий проект
// объявляет явно — телом одной функции, а не порядком инициализации пакетов.
//
// Точка одна, и она после .env: godotenv.Load не перезаписывает переменные,
// которые уже есть в окружении, но добавляет те, которых нет, поэтому хук,
// вызванный раньше, судил бы об окружении, которого процесс не увидит.
//
// Раньше то же самое делалось из init() — неявный side-effect при импорте,
// зависящий от порядка инициализации пакетов. В сгенерированных проектах init()
// запрещён линтером (gochecknoinits).
func (e *EmptyEarlyInit) earlyInit() error { return nil }

// UserEarlyInit — тип, на котором проект перекрывает earlyInit.
type UserEarlyInit struct {
	EmptyEarlyInit
}

func main() {
	exitCode := run()
	os.Exit(exitCode)
}

func run() int {
	// initialization parent background context
	mainCtx := context.Background()

	_, err := os.Lstat(envFileName)
	if !os.IsNotExist(err) {
		err := godotenv.Load(envFileName)
		if err != nil {
			log.Fatal("Error loading .env file")
		}
	}

	// Ранняя точка расширения проекта. Логгера ещё нет — об ошибке сообщает
	// stderr через log, как и о неудачном Initialize ниже; команда не
	// выполняется.
	earlyFunc := UserEarlyInit{}

	err = earlyFunc.earlyInit()
	if err != nil {
		log.Printf("early initialization failed: %v", err)
		return ExitCodeErrorEarlyInit
	}

	// Initialize onlineconf
	mainCtx, err = {{ .OnlineConf.GetPackageName }}.Initialize(mainCtx, getOnlineconfDir())
	if err != nil {
		log.Printf("failed to initialize onlineconf: %v", err)
		return ExitCodeErrorConfig
	}

	// Инициализация логгера
	mainCtx = {{ .Logger.InitLogger "mainCtx" "constant.ServiceName" }}

	{{ .Logger.DebugMsg "mainCtx" "CLI application starting" }}

	// Initialize drivers
	{{ range $_, $drv := .Application.Drivers }}
	drv{{ $drv.Package | Capitalize }}, err := {{ $drv.Package }}.Create( {{ range $_, $param := $drv.CreateParams }}{{ $drv.Package }}.{{ $param }}, {{ end }} ).Init(mainCtx, constant.ServiceName, nil, nil)
	if err != nil {
		{{ $.Logger.ErrorMsg "mainCtx" "err" "can't initialize driver" }}
		return ExitCodeErrorDriver
	}
	defer drv{{ $drv.Package | Capitalize }}.Shutdown(mainCtx)
	{{ end }}

	{{ if .Application.UseActiveRecord }}
	// Initialize ActiveRecord
	activerecord.InitActiveRecord(
		activerecord.WithLogger(arzlog.NewARLogger(arlogger.InfoLoggerLevel)),
		activerecord.WithConfig(func(ctx context.Context) activerecord.ConfigInterface { return {{ .OnlineConf.GetPackageName }}.ActiveRecordConfig(ctx) }),
	)
	{{- end }}

	// Create service
	srv, err := service.NewService(mainCtx)
	if err != nil {
		{{ .Logger.ErrorMsg "mainCtx" "err" "can't create new service" }}
		return ExitCodeErrorService
	}

{{- if .Application.GetStaticOgenClients }}

	// Initialize the API clients this CLI calls. A CLI has no HTTP listener and
	// no metrics registry, so it does not go through the runtime's app.Init —
	// the clients are handed to the service here instead.
	emptySrv, ok := srv.(*service.EmptyService)
	if !ok {
		fmt.Fprintf(os.Stderr, "Error: service of type %T cannot initialize API clients\n", srv)
		return ExitCodeErrorService
	}

	err = emptySrv.InitClients(mainCtx, []ds.ClientInitializer{
		{{- range $_, $tr := .Application.GetStaticOgenClients }}
		{{ $tr.Name }}.NewClient(),
		{{- end }}
	})
	if err != nil {
		{{ .Logger.ErrorMsg "mainCtx" "err" "can't initialize clients" }}
		return ExitCodeErrorService
	}
{{- end }}

	// Create CLI handler
	cliHandler := {{ .Application.CLI.Init }}

	// Parse command and arguments (shell-like: first word is command, rest are args)
	if len(os.Args) < 2 {
		// PrintHelp already prints its own command-list header — don't duplicate it here.
		fmt.Fprintf(os.Stderr, "Usage: %s <command> [arguments...]\n\n", os.Args[0])
		cliHandler.PrintHelp(os.Stderr)
		return ExitCodeErrorRun
	}

	command := os.Args[1]
	args := os.Args[2:]

	// Execute CLI command
	err = cliHandler.Execute(mainCtx, command, args)
	if err != nil {
		{{ .Logger.ErrorMsg "mainCtx" "err" "CLI command failed" }}
		fmt.Fprintf(os.Stderr, "Error: %v\n", err)
		return ExitCodeErrorRun
	}

	{{ .Logger.DebugMsg "mainCtx" "CLI command completed successfully" }}
	return ExitCodeOK
}

// getOnlineconfDir returns the onlineconf config directory path.
// It checks ONLINECONF_DIR environment variable first, falls back to default.
func getOnlineconfDir() string {
	if dir := os.Getenv(onlineconfDirEnvVar); dir != "" {
		return dir
	}

	return defaultOnlineconfDir
}
