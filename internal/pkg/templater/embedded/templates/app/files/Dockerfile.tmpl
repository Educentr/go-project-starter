FROM golang:{{ .GoLangVersion }}-alpine AS builder
ARG binary=bin/{{ .Application.Name }}
ARG GOPROXY
{{- range $_, $arg := .Docker.BuilderArgs }}
ARG {{ $arg.Name }}
{{- end }}

RUN set -xe  && \
    apk add --no-cache make git openssh-client
ENV CGO_ENABLED=0
{{- if .PrivateRepos }}
ENV GOPRIVATE="{{ .PrivateRepos }}"
{{- end }}
WORKDIR /go/src/app

# Module download is a separate layer so it is reused until go.mod/go.sum change.
# The module and build caches are BuildKit cache mounts: they survive between
# builds on the same builder, so nothing is re-downloaded or recompiled from
# scratch when only sources change.
#
# Both RUNs fetch modules, so both need the git credentials. The credential
# setup is per-layer, not per-image, and does not carry over from the RUN above,
# hence the repetition. It is also removed before the layer is committed, so the
# token never ends up in a cached layer.
#
# Credentials come from SSH (local dev) or a GitHub token (CI)
# - Local: docker-compose build (uses ssh agent)
# - CI: docker build --secret id=github_token (uses token)
COPY go.mod go.sum ./
RUN --mount=type=ssh --mount=type=secret,id=github_token \
    --mount=type=cache,target=/go/pkg/mod \
    if [ -f /run/secrets/github_token ]; then \
        export GITHUB_TOKEN=$(cat /run/secrets/github_token) && \
        git config --global url."https://x-access-token:${GITHUB_TOKEN}@github.com/".insteadOf "https://github.com/"; \
    else \
        mkdir -p -m 0700 ~/.ssh && \
        ssh-keyscan github.com > ~/.ssh/known_hosts && \
        git config --global url."git@github.com:".insteadOf "https://github.com/"; \
    fi && \
    go mod download && \
    rm -f ~/.gitconfig

COPY . .
RUN --mount=type=ssh --mount=type=secret,id=github_token \
    --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    if [ -f /run/secrets/github_token ]; then \
        export GITHUB_TOKEN=$(cat /run/secrets/github_token) && \
        git config --global url."https://x-access-token:${GITHUB_TOKEN}@github.com/".insteadOf "https://github.com/"; \
    else \
        mkdir -p -m 0700 ~/.ssh && \
        ssh-keyscan github.com > ~/.ssh/known_hosts && \
        git config --global url."git@github.com:".insteadOf "https://github.com/"; \
    fi && \
    make build_in_docker-{{ .Application.Name }} && \
    cp ${binary} /service && \
    rm -f ~/.gitconfig

RUN mkdir -p /public
ADD public /public
RUN chmod -R 755 /public
{{- range $dir := .Application.StaticDirs }}

RUN mkdir -p /{{ $dir }}
ADD {{ $dir }} /{{ $dir }}
RUN chmod -R 755 /{{ $dir }}
{{- end }}

FROM alpine
COPY --from=builder /service /service
COPY --from=builder /public /public
{{- range $dir := .Application.StaticDirs }}
COPY --from=builder /{{ $dir }} /{{ $dir }}
{{- end }}
RUN mkdir -p /etc/onlineconf
CMD ["/service"]

{{- range $_, $t := .Applications.GetRestTransport }}
# {{ $t.Name }}/{{ $t.Type }}
EXPOSE {{ $t.Port }}
{{- end }}
{{- if .Docker.FinalArgs }}

# Build arguments of the runtime stage, declared in the docker section of
# project.yaml. They are last in the stage on purpose: an ARG invalidates the
# build cache of the layers below it, and values like a version or a revision
# change on every commit.
{{- range $_, $arg := .Docker.FinalArgs }}
ARG {{ $arg.Name }}
{{- end }}
{{- end }}
{{- with .Docker.LabelDirective }}

{{ . }}
{{- end }}
