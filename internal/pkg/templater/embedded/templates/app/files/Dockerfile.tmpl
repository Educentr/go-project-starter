{{ range $_, $w := $.WebApps.ForApp $.Application }}# Frontend '{{ $w.Name }}', declared in the `web` section of project.yaml. It
# is built here rather than taken from the host so the image carries the
# frontend the sources describe, and so the node toolchain never reaches the
# runtime stage. The whole context is copied, as in the builder stage below: a
# frontend build reads more than {{ $w.Dir }} (the generated client, shared
# configs), and which files exactly is the project's business.
{{- if $.Application.Docker.HasPlatforms }}
#
# The stage is pinned to the platform of the build host (BUILDPLATFORM): this
# image is built for the target platforms listed below, and an unpinned stage
# would be built once per platform, under emulation of each. The build writes
# static files, which do not depend on the target architecture, so one native
# run of it serves every platform of the image.
{{- end }}
{{ $w.StageFrom $.Application.Docker.HasPlatforms }}
WORKDIR /src
COPY . .
{{- if $w.Install }}
RUN cd {{ $w.Dir }} && {{ $w.Install }}
{{- end }}
RUN cd {{ $w.Dir }} && {{ $w.Build }}

{{ end }}{{ range $_, $f := .Application.Docker.Fetch }}# Tool '{{ $f.Name }}', declared in the `fetch` list of the docker section of
# the application in project.yaml. It arrives in a stage of its own and is
# copied into the runtime stage below, rather than being added there directly:
# that keeps the runtime stage free of RUN (so a shell-less base image still
# builds) and of ARG (whose value change invalidates the cache of every layer
# under it). The mode is set by the instruction itself — ADD from a URL leaves
# the file non-executable, and a chmod would need a shell this stage has none of.
{{- if $f.PerPlatform }}
#
# One digest cannot cover a file whose name carries the architecture, and a
# Dockerfile cannot choose between digests. Hence a stage per declared
# architecture plus the selector below it, where TARGETARCH resolves in the
# global scope. BuildKit builds only the stage the selector reaches, so a build
# downloads the file of the architecture it is building for and no other.
{{- range $_, $v := $f.Variants }}
FROM scratch AS {{ $f.VariantStageName $v.Arch }}
ARG TARGETARCH
ARG TARGETOS
{{ $f.AddDirective $v.Digest }}
{{- end }}
FROM {{ $f.SelectorImage }} AS {{ $f.StageName }}
{{- else }}
FROM scratch AS {{ $f.StageName }}
ARG TARGETARCH
ARG TARGETOS
{{ $f.AddDirective $f.Checksum }}
{{- end }}

{{ end }}{{ range $_, $s := .Application.Docker.Stages }}# Stage '{{ $s.Name }}', declared in the `stages` list of the docker section of
# the application in project.yaml — a tool no package manager provides is
# installed here and copied into the runtime stage below.
#
# Pinned to the platform of the build host: a multi-platform build would
# otherwise run the stage once per target platform, under emulation. Whatever is
# architecture-dependent in it takes the target from TARGETARCH, declared below,
# and so has to pass it on explicitly. The stage gets no build context, so the
# version of the tool is pinned in the command itself.
{{ $s.StageFrom }}
ARG TARGETARCH
ARG TARGETOS
{{- with $s.WorkdirDirective }}
{{ . }}
{{- end }}
{{- range $_, $cmd := $s.Run }}
RUN {{ $cmd }}
{{- end }}

{{ end }}{{ if .Application.Docker.HasPlatforms }}# Target platforms: {{ .Application.Docker.PlatformList }} (applications[].docker.platforms).
# The builder runs natively on the platform of the build host (BUILDPLATFORM) and
# cross-compiles for TARGETARCH — Go cross-compiles itself, so no emulation of the
# target architecture is involved in the build of the binary.
FROM --platform=$BUILDPLATFORM golang:{{ .GoLangVersion }}-alpine AS builder
ARG binary=bin/{{ .Application.Name }}
ARG GOPROXY
ARG TARGETARCH
{{- else -}}
FROM golang:{{ .GoLangVersion }}-alpine AS builder
ARG binary=bin/{{ .Application.Name }}
ARG GOPROXY
{{- end }}
{{- range $_, $arg := .Docker.BuilderArgs }}
ARG {{ $arg.Name }}
{{- end }}

RUN set -xe  && \
    apk add --no-cache make git openssh-client
ENV CGO_ENABLED=0
{{- if .GoPrivate }}
ENV GOPRIVATE="{{ .GoPrivate }}"
{{- end }}
WORKDIR /go/src/app

# Module download is a separate layer so it is reused until go.mod/go.sum change.
# The module and build caches are BuildKit cache mounts: they survive between
# builds on the same builder, so nothing is re-downloaded or recompiled from
# scratch when only sources change.
#
# Both RUNs fetch modules, so both need the git credentials. The credential
# setup is per-layer, not per-image, and does not carry over from the RUN above,
# hence the repetition. It is also removed before the layer is committed, so the
# token never ends up in a cached layer.
#
# Credentials come from SSH (local dev) or a GitHub token (CI)
# - Local: docker-compose build (uses ssh agent)
# - CI: docker build --secret id=github_token (uses token)
COPY go.mod go.sum ./
RUN --mount=type=ssh --mount=type=secret,id=github_token \
    --mount=type=cache,target=/go/pkg/mod \
    if [ -f /run/secrets/github_token ]; then \
        export GITHUB_TOKEN=$(cat /run/secrets/github_token) && \
        git config --global url."https://x-access-token:${GITHUB_TOKEN}@github.com/".insteadOf "https://github.com/"; \
    else \
        mkdir -p -m 0700 ~/.ssh && \
        ssh-keyscan github.com > ~/.ssh/known_hosts && \
        git config --global url."git@github.com:".insteadOf "https://github.com/"; \
    fi && \
    go mod download && \
    rm -f ~/.gitconfig

COPY . .
RUN --mount=type=ssh --mount=type=secret,id=github_token \
    --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    if [ -f /run/secrets/github_token ]; then \
        export GITHUB_TOKEN=$(cat /run/secrets/github_token) && \
        git config --global url."https://x-access-token:${GITHUB_TOKEN}@github.com/".insteadOf "https://github.com/"; \
    else \
        mkdir -p -m 0700 ~/.ssh && \
        ssh-keyscan github.com > ~/.ssh/known_hosts && \
        git config --global url."git@github.com:".insteadOf "https://github.com/"; \
    fi && \
{{- if .Application.Docker.HasPlatforms }}
    GOARCH=${TARGETARCH:?TARGETARCH is empty, build the image with BuildKit} \
        make build_in_docker-{{ .Application.Name }} && \
{{- else }}
    make build_in_docker-{{ .Application.Name }} && \
{{- end }}
    cp ${binary} /service && \
    rm -f ~/.gitconfig

RUN mkdir -p /public
ADD public /public
RUN chmod -R 755 /public
{{- range $dir := .Application.StaticDirs }}

RUN mkdir -p /{{ $dir }}
ADD {{ $dir }} /{{ $dir }}
RUN chmod -R 755 /{{ $dir }}
{{- end }}
{{- range $_, $w := $.WebApps.ForApp $.Application }}

# Built frontend '{{ $w.Name }}' over whatever {{ $w.Output }}/ carries in the
# build context: the build is the authority on what the service serves.
COPY --from={{ $w.StageName }} /src/{{ $w.Output }}/ /{{ $w.Output }}/
RUN chmod -R 755 /{{ $w.Output }}
{{- end }}

# The config directory is created here and copied into the runtime stage, not
# created there: a `RUN mkdir` needs a shell, and a shell-less base image
# (distroless, scratch) is a valid runtime for a static Go binary. A RUN in the
# runtime stage of a cross-built image would also run for the target
# architecture and so need emulation, while the binary it accompanies is
# already cross-compiled by the native builder.
RUN mkdir -p /etc/onlineconf

FROM {{ .Application.Docker.Image }}
{{- with .Application.Docker.PackagesDirective }}

# Runtime packages, declared in the docker section of the application in
# project.yaml. Installed before the binary is copied, so the layer is reused
# until the package list itself changes.
{{ . }}
{{ end }}
{{- range $_, $c := .Application.Docker.Copy }}
# Project directory, declared in the `copy` list of the docker section of the
# application in project.yaml. Copied straight from the build context and not
# through the builder stage: COPY needs neither a shell nor the target
# architecture, so this keeps the stage buildable on a shell-less base image
# and free of emulation, and nothing of the project lands in the builder where
# it could overwrite its toolchain.
#
# The project-declared additions come before the service binary, as the package
# install does: the binary changes on every build, and below it their layers —
# including a copied tool prefix — would be rebuilt along with it.
COPY {{ $c.From }} {{ $c.To }}
{{- end }}
{{- range $_, $f := .Application.Docker.Fetch }}
COPY --from={{ $f.StageName }} {{ $f.Path }} {{ $f.To }}
{{- end }}
{{- range $_, $s := .Application.Docker.Stages }}
{{- range $_, $c := $s.Copy }}
COPY --from={{ $s.StageName }} {{ $c.From }} {{ $c.To }}
{{- end }}
{{- end }}
COPY --from=builder /service /service
COPY --from=builder /public /public
{{- range $dir := .Application.StaticDirs }}
COPY --from=builder /{{ $dir }} /{{ $dir }}
{{- end }}
# Copying the directory from a stage keeps the ownership and mode it has there
# (root:root, 0755) — the same a `mkdir -p` in this stage would have given.
COPY --from=builder /etc/onlineconf /etc/onlineconf
{{- with .Application.Docker.EnvDirective }}

# Runtime environment, declared in the `env` list of the docker section of the
# application in project.yaml — one instruction, so one layer.
{{ . }}
{{- end }}
{{- with .Application.Docker.WorkdirDirective }}
{{ . }}
{{- end }}
{{ .Application.Docker.StartDirective }}

{{- /* This application's own listening transports, not the project's: the
       image of a CLI application used to announce the ports of its neighbors,
       and a client transport used to render EXPOSE 0 — ports `docker run -P`,
       the image metadata and image scanners would look for and not find. */}}
{{- range $_, $t := .Application.GetRestServerTransport }}
# {{ $t.Name }}/{{ $t.Type }}
EXPOSE {{ $t.Port }}
{{- end }}
{{- if .Docker.FinalArgs }}

# Build arguments of the runtime stage, declared in the docker section of
# project.yaml. They are last in the stage on purpose: an ARG invalidates the
# build cache of the layers below it, and values like a version or a revision
# change on every commit.
{{- range $_, $arg := .Docker.FinalArgs }}
ARG {{ $arg.Name }}
{{- end }}
{{- end }}
{{- with .Docker.LabelDirective }}

{{ . }}
{{- end }}
