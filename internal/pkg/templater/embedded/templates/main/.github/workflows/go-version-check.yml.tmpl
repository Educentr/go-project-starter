name: Go Version Policy Check

on:
  push:
    branches: {{ $.GithubCI.PushBranchesFlow }}
  pull_request:

jobs:
  check-go-mod-version:
    {{ $.GithubCI.JobHeader }}
    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: false
      - uses: actions/setup-go@v5
        with:
          go-version-file: go.mod
{{- if .PrivateRepos }}
      # check-go-mod-version.sh downloads the direct dependencies, so it needs
      # the same private-module access as the jobs of ci_cd.yml. Unlike there,
      # the block is conditional: this job only reads go.mod and the versions
      # of the direct dependencies, and without declared private modules the
      # proxy serves all of them, so there is nothing to take off it.
{{- template "privateModulesAccess" $ }}
{{- end }}
      - name: Check go.mod version against direct dependencies
        run: ./scripts/check-go-mod-version.sh
