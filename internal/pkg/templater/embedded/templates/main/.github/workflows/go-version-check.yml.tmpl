name: Go Version Policy Check

on:
  push:
    branches: {{ $.GithubCI.PushBranchesFlow }}
  pull_request:

jobs:
  check-go-mod-version:
    {{ $.GithubCI.JobHeader }}
    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: false
      - uses: actions/setup-go@v5
        with:
          go-version-file: go.mod
{{- /* check-go-mod-version.sh downloads the direct dependencies, so this job
needs the same private-module access as the jobs of ci_cd.yml. The fragment
decides on its own whether there is anything to render. */}}
{{- template "privateModulesAccess" $ }}
      - name: Check go.mod version against direct dependencies
        run: ./scripts/check-go-mod-version.sh
