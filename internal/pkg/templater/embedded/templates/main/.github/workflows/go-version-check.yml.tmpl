name: Go Version Policy Check

on:
  push:
    branches: [main, staging]
  pull_request:

jobs:
  check-go-mod-version:
    {{ $.GithubCI.JobHeader }}
    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: false
      - uses: actions/setup-go@v5
        with:
          go-version-file: go.mod
      - name: Check go.mod version against direct dependencies
        run: ./scripts/check-go-mod-version.sh
