name: CI Pipeline

on:
  push:
    branches:
      {{ $.GithubCI.PushBranchesBlock }}

jobs:
  prepare-env:
    {{ $.GithubCI.JobHeader }}
    outputs:
      ENABLE_BUILD: ${{"{{"}} steps.vars_enabled.outputs.ENABLE_BUILD {{"}}"}}
      RELEASE: ${{"{{"}} steps.vers_and_containers.outputs.RELEASE {{"}}"}}
{{- if .Artifacts.HasDocker }}
      CONTAINERS: ${{"{{"}} steps.vers_and_containers.outputs.CONTAINERS {{"}}"}}
{{- end }}
{{- if .Artifacts.HasDocker }}
      ARTIFACTS: ${{"{{"}} steps.vers_and_containers.outputs.ARTIFACTS {{"}}"}}
{{- end }}
{{- if .Artifacts.HasPackaging }}
      PACKAGES: ${{"{{"}} steps.vers_and_containers.outputs.PACKAGES {{"}}"}}
{{- end }}
{{- if .Artifacts.HasDocker }}
      ENABLE_DEPLOY: ${{"{{"}}steps.vars_enabled.outputs.ENABLE_DEPLOY {{"}}"}}
      DEPLOY_ENVS: ${{"{{"}} steps.vars_deploy.outputs.DEPLOY_ENVS {{"}}"}}
      OC_HOST: ${{"{{"}} steps.vars_deploy.outputs.OC_HOST {{"}}"}}
      OC_PORT: ${{"{{"}} steps.vars_deploy.outputs.OC_PORT {{"}}"}}
      OC_USER: ${{"{{"}} steps.set_env_main.outputs.OC_USER {{"}}"}}
      OC_PASSWORD: ${{"{{"}} steps.set_env_main.outputs.OC_PASSWORD {{"}}"}}
      ENV_TYPE: ${{"{{"}} steps.set_env_main.outputs.ENV_TYPE {{"}}"}}
      LEN_EXPECTED: ${{"{{"}} steps.vars_deploy.outputs.LEN_EXPECTED {{"}}"}}
      SSH_HOST_MATRIX: ${{"{{"}} steps.vars_deploy.outputs.SSH_HOST_MATRIX {{"}}"}}
      INTERNAL_SUBNET: ${{"{{"}} steps.vars_deploy.outputs.INTERNAL_SUBNET {{"}}"}}
      {{- range $_, $a := .Applications }}{{ if $a.HasDocker }}
        {{ $applicationName := $a.Name | ReplaceDash }}
      PORT_PREFIX_{{ $applicationName | ToUpper }}_TRAEFIK: ${{"{{"}} steps.set_env_main.outputs.PORT_PREFIX_{{ $applicationName | ToUpper }}_TRAEFIK {{"}}"}}
        {{- range $_, $t := $a.GetRestTransport }}{{ if ne $t.GeneratorType "ogen_client" }}
        {{ if and $t.PublicService ($.Applications.DeclaresPublicDomain $a.Name $t.Name) }}
      DOMAIN_{{ $t.Name | ToUpper }}: ${{"{{"}} steps.set_env_main.outputs.DOMAIN_{{ $t.Name | ToUpper }} {{"}}"}}
        {{ end }}
      PORT_PREFIX_{{ $applicationName | ToUpper }}_{{ $t.Name | ToUpper }}: ${{"{{"}} steps.set_env_main.outputs.PORT_PREFIX_{{ $applicationName | ToUpper }}_{{ $t.Name | ToUpper }} {{"}}"}}
        {{ end }}{{ end }}
      {{ end }}{{ end }}
{{- end }}

    steps:
      # Переменные и секреты ветки называются <NAME>_<СУФФИКС>, где суффикс —
      # имя ветки в верхнем регистре, в котором всё, что не [A-Za-z0-9_],
      # заменено на `_`: других символов GitHub в именах переменных и секретов
      # не допускает, поэтому ветка release/1.2 ищет ENABLED_RELEASE_1_2.
      # Шаг заменяет noliran/branch-based-secrets@v1: тот подставлял имя ветки
      # как есть (ENABLED_RELEASE/1.2), то есть имя, которого не может быть, —
      # и любая ветка со `/` или `-` в github_ci.push_branches оставалась без
      # сборки при зелёном run'е.
      - name: Get branch
        run: |
          BRANCH="${GITHUB_REF#refs/heads/}"
          SUFFIX="${BRANCH//[^A-Za-z0-9_]/_}"
          SUFFIX="${SUFFIX^^}"

          echo "Target branch: $BRANCH (variable suffix: $SUFFIX)"

          for NAME in ENABLED{{ if .Artifacts.HasDocker }} ENV_TYPE OC_USER OC_PASSWORD OC_HOST OC_PORT{{- range $_, $a := .Applications }}{{ if $a.HasDocker }} PORT_PREFIX_{{ $a.Name | ToUpper | ReplaceDash }}_TRAEFIK{{ range $_, $t := $a.GetRestTransport }}{{ if ne $t.GeneratorType "ogen_client" }} PORT_PREFIX_{{ $a.Name | ToUpper | ReplaceDash }}_{{ $t.Name | ToUpper }}{{ if and $t.PublicService ($.Applications.DeclaresPublicDomain $a.Name $t.Name) }} DOMAIN_{{ $t.Name | ToUpper }}{{ end }}{{ end }}{{ end }}{{ end }}{{ end }} SSH_HOST INTERNAL_SUBNET{{ end }}; do
            # tee: имена переменных ветки видно в логе шага — по ним понятно,
            # что надо завести в настройках репозитория для новой ветки.
            echo "${NAME}_NAME=${NAME}_${SUFFIX}" | tee -a "$GITHUB_ENV"
          done

      - name: Use vars
        id: vars_enabled
        env:
          # Значение переменной репозитория приходит переменной окружения, а не
          # текстом скрипта: workflow-выражение в run: раскрывается до запуска
          # shell, поэтому значение стало бы частью исходника скрипта (GitHub
          # Security hardening -> script injection). Содержимое выбирает тот,
          # кто настраивает репозиторий, то есть эскалации прав тут нет, — но
          # одинарная кавычка в значении закрывает `'…'` и остаток строки
          # читается как код, а `$(…)` выполняется.
          #
          # Правило действует на все шаги обоих workflow: ни в одном run: нет
          # ${{"{{"}} secrets.* {{"}}"}}, ${{"{{"}} vars.* {{"}}"}},
          # ${{"{{"}} needs.*.outputs.* {{"}}"}} и ${{"{{"}} steps.*.outputs.* {{"}}"}}.
          #
          # ${{"{{"}} env.<ИМЯ>_NAME {{"}}"}} в run: остаётся: суффикс там собран из
          # имени ветки, нормализованного до [A-Za-z0-9_] (шаг `Get branch`),
          # других символов GitHub в именах переменных и секретов не допускает.
          ENABLED: ${{"{{"}} vars[env.ENABLED_NAME] {{"}}"}}
        run: |
          if [ "$ENABLED" == "ENABLED" ]; then
            echo "ENABLE_BUILD=true" >> $GITHUB_OUTPUT
{{- if .Artifacts.HasDocker }}
            echo "ENABLE_DEPLOY=true" >> $GITHUB_OUTPUT
{{- end }}
          elif [ "$ENABLED" == "ENABLED_ONLY_BUILD" ]; then
            echo "ENABLE_BUILD=true" >> $GITHUB_OUTPUT
{{- if .Artifacts.HasDocker }}
            echo "ENABLE_DEPLOY=false" >> $GITHUB_OUTPUT
            echo "DEPLOY_ENVS=[]" >> $GITHUB_OUTPUT
{{- end }}
          else
            echo "::notice title=Build is not enabled for this branch::Repository variable ${{"{{"}} env.ENABLED_NAME {{"}}"}} is set to neither ENABLED nor ENABLED_ONLY_BUILD, so every job of this run is skipped"
            echo "Skip branch ${GITHUB_REF}: expected the repository variable ${{"{{"}} env.ENABLED_NAME {{"}}"}}"
            echo "ENABLE_BUILD=false" >> $GITHUB_OUTPUT
{{- if .Artifacts.HasDocker }}
            echo "ENABLE_DEPLOY=false" >> $GITHUB_OUTPUT
            echo "DEPLOY_ENVS=[]" >> $GITHUB_OUTPUT
{{- end }}
            exit 0
          fi

{{ if .Artifacts.HasDocker }}
      - name: Deploy vars
        id: vars_deploy
        if: steps.vars_enabled.outputs.ENABLE_DEPLOY == 'true'
        env:
          # Переменные репозитория приходят переменными окружения, а не текстом
          # скрипта, — см. комментарий в шаге `Use vars`. Значение пишется
          # через printf '%s', чтобы оно не попадало и в строку формата.
          SSH_HOST: ${{"{{"}} vars[env.SSH_HOST_NAME] {{"}}"}}
          OC_HOST: ${{"{{"}} vars[env.OC_HOST_NAME] {{"}}"}}
          OC_PORT: ${{"{{"}} vars[env.OC_PORT_NAME] {{"}}"}}
          INTERNAL_SUBNET: ${{"{{"}} vars[env.INTERNAL_SUBNET_NAME] {{"}}"}}
          # Массив типов окружений: шаг берёт только его длину.
          ENV_TYPE_JSON: ${{"{{"}} vars[env.ENV_TYPE_NAME] {{"}}"}}
        run: |
          if [ -z "$SSH_HOST" ]; then
            echo "Empty SSH_HOST"
            exit 1
          fi

          printf 'SSH_HOST_MATRIX=%s\n' "$SSH_HOST" >> "$GITHUB_OUTPUT"

          if [ -z "$OC_HOST" ]; then
            echo "Empty OC_HOST"
            exit 2
          fi
          printf 'OC_HOST=%s\n' "$OC_HOST" >> "$GITHUB_OUTPUT"

          if [ -z "$OC_PORT" ]; then
            echo "Empty OC_PORT use 443"
            echo 'OC_PORT=443' >> $GITHUB_OUTPUT
          else
            printf 'OC_PORT=%s\n' "$OC_PORT" >> "$GITHUB_OUTPUT"
          fi

          if [ -z "$INTERNAL_SUBNET" ]; then
            echo "Empty INTERNAL_SUBNET"
            exit 2
          fi
          printf 'INTERNAL_SUBNET=%s\n' "$INTERNAL_SUBNET" >> "$GITHUB_OUTPUT"

          LEN_EXPECTED=$(printf '%s\n' "$ENV_TYPE_JSON" | jq '. | length')
          if [ -z "$LEN_EXPECTED" ]; then
            LEN_EXPECTED=1
          fi

          echo "LEN_EXPECTED=$LEN_EXPECTED" >> $GITHUB_OUTPUT
          echo DEPLOY_ENVS="`jq -cn "[range(0; $LEN_EXPECTED)]"`" >> $GITHUB_OUTPUT
{{ end }}

{{ if .Artifacts.HasDocker }}
      - name: Check and set vars for instances
        id: set_env_main
        if: steps.vars_enabled.outputs.ENABLE_DEPLOY == 'true'

        env:
          # Переменные и секреты репозитория приходят переменными окружения, а
          # не текстом скрипта, — см. комментарий в шаге `Use vars`. Шаг читает
          # из них только длину массива, поэтому имена несут суффикс _JSON: в
          # $GITHUB_OUTPUT уезжает весь массив, индексирует его по номеру
          # окружения уже job create_env_files.
          LEN_EXPECTED: ${{"{{"}} steps.vars_deploy.outputs.LEN_EXPECTED {{"}}"}}
          {{- range $_, $a := .Applications }}{{ if $a.HasDocker }}
          PORT_PREFIX_{{ $a.Name | ToUpper | ReplaceDash }}_TRAEFIK_JSON: ${{"{{"}} vars[env.PORT_PREFIX_{{ $a.Name | ToUpper | ReplaceDash }}_TRAEFIK_NAME] {{"}}"}}
            {{- range $_, $t := $a.GetRestTransport }}{{ if ne $t.GeneratorType "ogen_client" }}
              {{- if and $t.PublicService ($.Applications.DeclaresPublicDomain $a.Name $t.Name) }}
          DOMAIN_{{ $t.Name | ToUpper }}_JSON: ${{"{{"}} vars[env.DOMAIN_{{ $t.Name | ToUpper }}_NAME] {{"}}"}}
              {{- end }}
          PORT_PREFIX_{{ $a.Name | ToUpper | ReplaceDash }}_{{ $t.Name | ToUpper }}_JSON: ${{"{{"}} vars[env.PORT_PREFIX_{{ $a.Name | ToUpper | ReplaceDash }}_{{ $t.Name | ToUpper }}_NAME] {{"}}"}}
            {{- end }}{{- end }}
          {{- end }}{{ end }}
          ENV_TYPE_JSON: ${{"{{"}} vars[env.ENV_TYPE_NAME] {{"}}"}}
          OC_USER_JSON: ${{"{{"}} secrets[env.OC_USER_NAME] {{"}}"}}
          OC_PASSWORD_JSON: ${{"{{"}} secrets[env.OC_PASSWORD_NAME] {{"}}"}}
        run: |
          {{- /* Отступ блочного скаляра задаёт его первая непустая строка, а
          ниже тут есть строки на 10 пробелах: первая строка этого run: обязана
          остаться на 10 пробелах, иначе YAML закроется на первой же строке с
          меньшим отступом и перестанет быть валидным. */ -}}
          {{- range $_, $a := .Applications }}{{ if $a.HasDocker }}
          if [ -z "$PORT_PREFIX_{{ $a.Name | ToUpper | ReplaceDash }}_TRAEFIK_JSON" ]; then
            echo "Empty variable ${{"{{"}} env.PORT_PREFIX_{{ $a.Name | ToUpper | ReplaceDash }}_TRAEFIK_NAME {{"}}"}}"
            exit 3
          fi

          LEN=$(printf '%s\n' "$PORT_PREFIX_{{ $a.Name | ToUpper | ReplaceDash }}_TRAEFIK_JSON" | jq '. | length')

          if [ "$LEN" != "$LEN_EXPECTED" ]; then
            echo "Invalid array size ${{"{{"}} env.PORT_PREFIX_{{ $a.Name | ToUpper | ReplaceDash }}_TRAEFIK_NAME {{"}}"}}: $LEN"
            exit 4
          fi

          printf 'PORT_PREFIX_{{ $a.Name | ToUpper | ReplaceDash }}_TRAEFIK=%s\n' "$PORT_PREFIX_{{ $a.Name | ToUpper | ReplaceDash }}_TRAEFIK_JSON" >> "$GITHUB_OUTPUT"

            {{- range $_, $t := $a.GetRestTransport }}{{ if ne $t.GeneratorType "ogen_client" }}
            {{ if and $t.PublicService ($.Applications.DeclaresPublicDomain $a.Name $t.Name) }}
          if [ -z "$DOMAIN_{{ $t.Name | ToUpper }}_JSON" ]; then
            echo "Empty variable ${{"{{"}} env.DOMAIN_{{ $t.Name | ToUpper }}_NAME {{"}}"}}"
            exit 5
          fi

          LEN=$(printf '%s\n' "$DOMAIN_{{ $t.Name | ToUpper }}_JSON" | jq '. | length')

          if [ "$LEN" != "$LEN_EXPECTED" ]; then
            echo "Invalid array size ${{"{{"}} env.DOMAIN_{{ $t.Name | ToUpper }}_NAME {{"}}"}}: $LEN"
            exit 6
          fi

          printf 'DOMAIN_{{ $t.Name | ToUpper }}=%s\n' "$DOMAIN_{{ $t.Name | ToUpper }}_JSON" >> "$GITHUB_OUTPUT"
            {{ end }}
          if [ -z "$PORT_PREFIX_{{ $a.Name | ToUpper | ReplaceDash }}_{{ $t.Name | ToUpper }}_JSON" ]; then
            echo "Empty variable ${{"{{"}} env.PORT_PREFIX_{{ $a.Name | ToUpper | ReplaceDash }}_{{ $t.Name | ToUpper }}_NAME {{"}}"}}"
            exit 3
          fi

          LEN=$(printf '%s\n' "$PORT_PREFIX_{{ $a.Name | ToUpper | ReplaceDash }}_{{ $t.Name | ToUpper }}_JSON" | jq '. | length')

          if [ "$LEN" != "$LEN_EXPECTED" ]; then
            echo "Invalid array size ${{"{{"}} env.PORT_PREFIX_{{ $a.Name | ToUpper | ReplaceDash }}_{{ $t.Name | ToUpper }}_NAME {{"}}"}}: $LEN"
            exit 4
          fi

          printf 'PORT_PREFIX_{{ $a.Name | ToUpper | ReplaceDash }}_{{ $t.Name | ToUpper }}=%s\n' "$PORT_PREFIX_{{ $a.Name | ToUpper | ReplaceDash }}_{{ $t.Name | ToUpper }}_JSON" >> "$GITHUB_OUTPUT"
            {{ end -}}{{ end -}}
          {{ end }}{{ end -}}

          LEN=$(printf '%s\n' "$ENV_TYPE_JSON" | jq '. | length')

          if [ "$LEN" != "$LEN_EXPECTED" ]; then
            echo "Invalid array size ${{"{{"}} env.ENV_TYPE_NAME {{"}}"}}: $LEN"
            exit 7
          fi

          printf 'ENV_TYPE=%s\n' "$ENV_TYPE_JSON" >> "$GITHUB_OUTPUT"

          if [ -z "$OC_USER_JSON" ]; then
            echo "Empty secrets ${{"{{"}} env.OC_USER_NAME {{"}}"}}"
            exit 8
          fi

          LEN=$(printf '%s\n' "$OC_USER_JSON" | jq '. | length')

          if [ "$LEN" != "$LEN_EXPECTED" ]; then
            echo "Invalid array size ${{"{{"}} env.OC_USER_NAME {{"}}"}}: $LEN"
            exit 9
          fi

          # Наружу уезжает имя секрета, а не его значение: индексирует секрет
          # по номеру окружения job create_env_files.
          echo 'OC_USER=${{"{{"}} env.OC_USER_NAME {{"}}"}}' >> $GITHUB_OUTPUT

          if [ -z "$OC_PASSWORD_JSON" ]; then
            echo "Empty secrets ${{"{{"}} env.OC_PASSWORD_NAME {{"}}"}}"
            exit 10
          fi
          LEN=$(printf '%s\n' "$OC_PASSWORD_JSON" | jq '. | length')

          if [ "$LEN" != "$LEN_EXPECTED" ]; then
            echo "Invalid array size ${{"{{"}} env.OC_PASSWORD_NAME {{"}}"}}: $LEN"
            exit 11
          fi

          echo 'OC_PASSWORD=${{"{{"}} env.OC_PASSWORD_NAME {{"}}"}}' >> $GITHUB_OUTPUT
{{ end }}

      - name: Checkout repository
        if: steps.vars_enabled.outputs.ENABLE_BUILD == 'true'
        uses: actions/checkout@v4
        with:
          persist-credentials: false

      - name: "Version and containers"
        id: vers_and_containers
        if: steps.vars_enabled.outputs.ENABLE_BUILD == 'true'
        run: |
          vers=$(make release-tag)
          echo "RELEASE=$vers" >> $GITHUB_OUTPUT
{{- if .Artifacts.HasDocker }}
          containerList=$(make docker-list)
          echo "CONTAINERS=$containerList" >> $GITHUB_OUTPUT
          art=$(make artifact-list)
          echo "ARTIFACTS=$art" >> $GITHUB_OUTPUT
{{- end }}
{{- if .Artifacts.HasPackaging }}
          pkg=$(make package-list)
          echo "PACKAGES=$pkg" >> $GITHUB_OUTPUT
{{- end }}
{{ if .Artifacts.HasDocker }}
      - name: Upload env file
        uses: actions/upload-artifact@v4
        if: steps.vars_enabled.outputs.ENABLE_DEPLOY == 'true'
        with:
          name: envs-docker
          path: docker-compose-*.yaml
          retention-days: 1
          overwrite: true
{{ end }}

{{- if .GithubCI.Checks.Enabled }}
{{ template "checksJob" $.ChecksOnPush }}{{ end }}

{{ if .Artifacts.HasDocker }}
  create_env_files:
    {{ $.GithubCI.JobHeader }}
    strategy:
      matrix:
        envs: ${{"{{"}} fromJSON(needs.prepare-env.outputs.DEPLOY_ENVS) {{"}}"}}
    needs:
      - prepare-env
    if: needs.prepare-env.outputs.ENABLE_DEPLOY == 'true'
    steps:
      - name: Create env file
        id: create_env_file
        env:
          # Имя ветки приходит переменной окружения, а не текстом скрипта:
          # workflow-выражение в run: раскрывается до запуска shell, поэтому
          # имя ветки стало бы частью исходника скрипта (GitHub Security
          # hardening -> script injection). Git допускает в именах веток
          # обратную кавычку, $, " и (), то есть release/$(cmd) выполнила бы
          # команду, а release/a`b уронила бы шаг синтаксической ошибкой.
          BRANCH: ${{"{{"}} github.ref_name {{"}}"}}
          # Остальные значения — того же класса, только источник другой:
          # переменные и секреты репозитория и версия из `make release-tag`
          # (git допускает `'` в имени тега). Содержимое выбирает тот, кто
          # настраивает репозиторий, то есть эскалации прав тут нет, — но
          # кавычка в значении закрывала `'…'` и остаток строки читался как
          # код, а ENV_TYPE подставлялся вообще без кавычек. См. комментарий в
          # шаге `Use vars` job'а prepare-env.
          ENV_TYPE: ${{"{{"}} fromJSON(needs.prepare-env.outputs.ENV_TYPE)[matrix.envs] {{"}}"}}
          {{- range $_, $a := .Applications }}{{ if $a.HasDocker }}
          PORT_PREFIX_{{ $a.Name | ToUpper | ReplaceDash }}_TRAEFIK: ${{"{{"}} fromJson(needs.prepare-env.outputs.PORT_PREFIX_{{ $a.Name | ToUpper | ReplaceDash }}_TRAEFIK)[matrix.envs] {{"}}"}}
            {{- range $_, $t := $a.GetRestTransport }}{{ if ne $t.GeneratorType "ogen_client" }}
              {{- if and $t.PublicService ($.Applications.DeclaresPublicDomain $a.Name $t.Name) }}
          DOMAIN_{{ $t.Name | ToUpper }}: ${{"{{"}} fromJson(needs.prepare-env.outputs.DOMAIN_{{ $t.Name | ToUpper }})[matrix.envs] {{"}}"}}
              {{- end }}
          PORT_PREFIX_{{ $a.Name | ToUpper | ReplaceDash }}_{{ $t.Name | ToUpper }}: ${{"{{"}} fromJson(needs.prepare-env.outputs.PORT_PREFIX_{{ $a.Name | ToUpper | ReplaceDash }}_{{ $t.Name | ToUpper }})[matrix.envs] {{"}}"}}
            {{- end }}{{- end }}
          {{- end }}{{ end }}
          OC_HOST: ${{"{{"}} needs.prepare-env.outputs.OC_HOST {{"}}"}}
          OC_PORT: ${{"{{"}} needs.prepare-env.outputs.OC_PORT {{"}}"}}
          OC_USER: ${{"{{"}} fromJson(secrets[needs.prepare-env.outputs.OC_USER])[matrix.envs] {{"}}"}}
          OC_PASSWORD: ${{"{{"}} fromJson(secrets[needs.prepare-env.outputs.OC_PASSWORD])[matrix.envs] {{"}}"}}
          APP_VERSION: ${{"{{"}} needs.prepare-env.outputs.RELEASE {{"}}"}}
          REGISTRY_SERVER: ${{"{{"}} secrets.REGISTRY_LOGIN_SERVER {{"}}"}}/${{"{{"}} vars.REGISTRY_CONTAINER {{"}}"}}
          INTERNAL_SUBNET: ${{"{{"}} needs.prepare-env.outputs.INTERNAL_SUBNET {{"}}"}}
        run: |
          # Имя ветки нормализуется тем же правилом, что и имена переменных
          # ветки (шаг `Get branch`): `/` в имени ветки сделал бы из `.env.`
          # путь в несуществующий каталог, и шаг падал бы на первом `>>`.
          fname=".env.${BRANCH//[^A-Za-z0-9_]/_}"

          if [ ! -z "$ENV_TYPE" ]; then
            fname="$fname-$ENV_TYPE"
          fi

          # Значение подставляется аргументом printf, а не строкой формата:
          # так оно не может ни закрыть кавычку, ни быть прочитано как `%`.
          {
          {{- range $_, $a := .Applications }}{{ if $a.HasDocker }}
            printf 'PORT_PREFIX_{{ $a.Name | ToUpper | ReplaceDash }}_TRAEFIK="%s"\n' "$PORT_PREFIX_{{ $a.Name | ToUpper | ReplaceDash }}_TRAEFIK"
            {{- range $_, $t := $a.GetRestTransport }}{{ if ne $t.GeneratorType "ogen_client" }}
              {{- if and $t.PublicService ($.Applications.DeclaresPublicDomain $a.Name $t.Name) }}
            printf 'DOMAIN_{{ $t.Name | ToUpper }}="%s"\n' "$DOMAIN_{{ $t.Name | ToUpper }}"
              {{- end }}
            printf 'PORT_PREFIX_{{ $a.Name | ToUpper | ReplaceDash }}_{{ $t.Name | ToUpper }}="%s"\n' "$PORT_PREFIX_{{ $a.Name | ToUpper | ReplaceDash }}_{{ $t.Name | ToUpper }}"
            {{- end }}{{- end }}
          {{- end }}{{ end }}
            printf 'ENV_TYPE=%s\n' "$ENV_TYPE"
            printf 'OC_HOST="%s"\n' "$OC_HOST"
            printf 'OC_PORT="%s"\n' "$OC_PORT"
            printf 'OC_USER="%s"\n' "$OC_USER"
            printf 'OC_PASSWORD="%s"\n' "$OC_PASSWORD"
            printf 'APP_VERSION="%s"\n' "$APP_VERSION"
            printf 'REGISTRY_SERVER=%s\n' "$REGISTRY_SERVER"
            printf 'INTERNAL_SUBNET=%s\n' "$INTERNAL_SUBNET"
          } >> "$fname"


          # ToDo add file encriptions
          echo "Generated $fname"
          printf 'FNAME=%s\n' "$fname" >> "$GITHUB_OUTPUT"

      - name: Upload env file
        uses: actions/upload-artifact@v4
        with:
          name: envs-${{"{{"}} matrix.envs {{"}}"}}
          path: ${{"{{"}} steps.create_env_file.outputs.FNAME {{"}}"}}
          retention-days: 1
          include-hidden-files: true
          overwrite: true

{{ range $_, $a := .Applications }}{{ if $a.GoatTests }}
  run-goat-tests-{{ $a.Name | ReplaceDash }}:
    {{ $.GithubCI.JobHeader }}
    needs:
      - prepare-env
    if: needs.prepare-env.outputs.ENABLE_BUILD == 'true' && vars.SKIP_GOAT_TESTS != 'true'
    permissions:
      contents: read
      packages: read
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          persist-credentials: false

      - name: Setup Go
        uses: actions/setup-go@v4
        with:
          go-version: '{{ $.GoLangVersion }}'
          cache: true

      {{ if eq $.RegistryType "github" }}
      - name: Log in to GitHub Container Registry
        uses: docker/login-action@v2
        with:
          registry: ghcr.io
          username: ${{"{{"}} secrets.GHCR_USER {{"}}"}}
          password: ${{"{{"}} secrets.GHCR_TOKEN {{"}}"}}
      {{ else if eq $.RegistryType "digitalocean" }}
{{- if $.GithubCI.DoctlFromImage }}
      - name: Log in to DO Container Registry
        env:
          DIGITALOCEAN_ACCESS_TOKEN: ${{"{{"}} secrets.REGISTRY_PASSWORD {{"}}"}}
        run: |
          doctl version
          doctl registry login
{{- else }}
      - name: Install doctl
        uses: digitalocean/action-doctl@v2
        with:
          token: ${{"{{"}} secrets.REGISTRY_PASSWORD {{"}}"}}
{{- if $.GithubCI.DoctlVersion }}
          version: {{ $.GithubCI.DoctlVersion }}
{{- end }}

      - name: Log in to DO Container Registry
        run: doctl registry login
{{- end }}
      {{ else if eq $.RegistryType "aws" }}
      - name: Configure AWS credentials
        uses: aws-actions/configure-aws-credentials@v4
        with:
          aws-access-key-id: ${{"{{"}} secrets.AWS_ACCESS_KEY_ID {{"}}"}}
          aws-secret-access-key: ${{"{{"}} secrets.AWS_SECRET_ACCESS_KEY {{"}}"}}
          aws-region: ${{"{{"}} secrets.AWS_REGION {{"}}"}}

      - name: Log in to Amazon ECR
        uses: aws-actions/amazon-ecr-login@v2
      {{ else if eq $.RegistryType "selfhosted" }}
      - name: Log in to Docker Registry
        uses: docker/login-action@v2
        with:
          registry: ${{"{{"}} secrets.REGISTRY_URL {{"}}"}}
          username: ${{"{{"}} secrets.REGISTRY_USERNAME {{"}}"}}
          password: ${{"{{"}} secrets.REGISTRY_PASSWORD {{"}}"}}
      {{ end }}
{{- template "privateModulesAccess" $ }}

      - name: Run GOAT tests for {{ $a.Name }}
        run: |
          make goat-tests-{{ $a.Name }}

      - name: Report GOAT tests status
        uses: act10ns/slack@v2
        if: failure()
        with:
          status: ${{"{{"}} job.status {{"}}"}}
          steps: ${{"{{"}} toJson(steps) {{"}}"}}
        env:
          SLACK_WEBHOOK_URL: ${{"{{"}} secrets.ACTION_MONITORING_SLACK {{"}}"}}
{{ end }}{{ end }}

  build:
    {{ $.GithubCI.JobHeader }}
    needs:
      - prepare-env
{{ range $_, $a := .Applications }}{{ if $a.GoatTests }}      - run-goat-tests-{{ $a.Name | ReplaceDash }}
{{ end }}{{ end }}{{ if .GithubCI.Checks.Enabled }}      - checks
{{ end }}    strategy:
      matrix:
        containers: ${{"{{"}} fromJSON(needs.prepare-env.outputs.CONTAINERS) {{"}}"}}
    if: |
      always() &&
      needs.prepare-env.outputs.ENABLE_BUILD == 'true' &&
      needs.prepare-env.result == 'success'{{ range $_, $a := .Applications }}{{ if $a.GoatTests }} &&
      (needs.run-goat-tests-{{ $a.Name | ReplaceDash }}.result == 'success' || needs.run-goat-tests-{{ $a.Name | ReplaceDash }}.result == 'skipped'){{ end }}{{ end }}{{ if .GithubCI.Checks.Enabled }} &&
      (needs.checks.result == 'success' || needs.checks.result == 'skipped'){{ end }}

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          persist-credentials: false

      {{ if eq .RegistryType "digitalocean" }}
{{- if $.GithubCI.DoctlFromImage }}
      - name: Log in to DO Container Registry
        env:
          DIGITALOCEAN_ACCESS_TOKEN: ${{"{{"}} secrets.REGISTRY_PASSWORD {{"}}"}}
        run: |
          doctl version
          doctl registry login
{{- else }}
      - name: Install doctl
        uses: digitalocean/action-doctl@v2
        with:
          token: ${{"{{"}} secrets.REGISTRY_PASSWORD {{"}}"}}
{{- if $.GithubCI.DoctlVersion }}
          version: {{ $.GithubCI.DoctlVersion }}
{{- end }}

      - name: Log in to DO Container Registry
        run: doctl registry login
{{- end }}
      {{ else if eq .RegistryType "github" }}
      - name: Log in to GitHub Container Registry
        uses: docker/login-action@v2
        with:
          registry: ghcr.io
          username: ${{"{{"}} secrets.GHCR_USER {{"}}"}}
          password: ${{"{{"}} secrets.GHCR_TOKEN {{"}}"}}
      {{ else if eq .RegistryType "aws" }}
      - name: Configure AWS credentials
        uses: aws-actions/configure-aws-credentials@v4
        with:
          aws-access-key-id: ${{"{{"}} secrets.AWS_ACCESS_KEY_ID {{"}}"}}
          aws-secret-access-key: ${{"{{"}} secrets.AWS_SECRET_ACCESS_KEY {{"}}"}}
          aws-region: ${{"{{"}} secrets.AWS_REGION {{"}}"}}

      - name: Log in to Amazon ECR
        uses: aws-actions/amazon-ecr-login@v2
      {{ else if eq .RegistryType "selfhosted" }}
      - name: Log in to Docker Registry
        uses: docker/login-action@v2
        with:
          registry: ${{"{{"}} secrets.REGISTRY_URL {{"}}"}}
          username: ${{"{{"}} secrets.REGISTRY_USERNAME {{"}}"}}
          password: ${{"{{"}} secrets.REGISTRY_PASSWORD {{"}}"}}
      {{ else }}
        {{ .UndefinedRegistryTypeError .RegistryType }}
      {{ end }}
      # No private-module access is configured here: this job runs no Go on the
      # runner. It calls `make docker-<app>`, which builds the image, and the
      # modules are downloaded inside it — from the BuildKit secret the step
      # below passes as GITHUB_TOKEN, not from the runner's git config.
      - name: "Build and push"
        id: build_and_push
        env:
          REGISTRY_SERVER: ${{"{{"}} secrets.REGISTRY_LOGIN_SERVER {{"}}"}}/${{"{{"}} vars.REGISTRY_CONTAINER {{"}}"}}
          GITHUB_TOKEN: ${{"{{"}} secrets.{{ $.PrivateReposTokenSecretName }} {{"}}"}}
        run: |
          make ${{"{{"}} matrix.containers {{"}}"}}
          make ${{"{{"}} matrix.containers {{"}}"}}-push

      - name: Report Build status
        uses: act10ns/slack@v2
        if: failure()
        with:
          status: ${{"{{"}} job.status {{"}}"}}
          steps: ${{"{{"}} toJson(steps) {{"}}"}}
          matrix: ${{"{{"}} toJson(matrix) {{"}}"}}
        env:
          SLACK_WEBHOOK_URL: ${{"{{"}} secrets.ACTION_MONITORING_SLACK {{"}}"}}
{{ end }}

{{ if .Artifacts.HasPackaging }}
