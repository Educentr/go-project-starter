{{ if .Artifacts.HasUpload }}
  # Upload packages to storage
  # Required repository variables/secrets:
  {{- if .Artifacts.IsMinio }}
  #   secrets.MINIO_ACCESS_KEY, secrets.MINIO_SECRET_KEY - MinIO credentials
  #   vars.UPLOAD_ENDPOINT - MinIO endpoint URL (e.g., https://minio.example.com)
  #   vars.UPLOAD_BUCKET - Target bucket name
  #   vars.UPLOAD_PREFIX - Path prefix in bucket (optional, default: packages)
  {{- else if .Artifacts.IsAWS }}
  #   secrets.AWS_ACCESS_KEY_ID, secrets.AWS_SECRET_ACCESS_KEY - AWS credentials
  #   vars.UPLOAD_BUCKET - Target S3 bucket name
  #   vars.UPLOAD_REGION - Bucket region (optional, default: us-east-1)
  #   vars.UPLOAD_PREFIX - Path prefix in bucket (optional, default: packages)
  {{- else if .Artifacts.IsRsync }}
  #   secrets.UPLOAD_SSH_PRIVATE_KEY - SSH private key for rsync
  #   vars.UPLOAD_HOST - Target SSH host
  #   vars.UPLOAD_USER - SSH username
  #   vars.UPLOAD_PATH - Remote path for packages
  {{- end }}
  upload-packages:
    {{ $.GithubCI.JobHeader }}
    needs:
      - build-packages
{{- /* prepare-env стоит в needs потому, что его читает условие ниже: контекст
       needs содержит только перечисленные здесь job'ы, поэтому без этой
       строки needs.prepare-env — null, условие ложно, и job не выполняется
       никогда (TOOLS-130). Run при этом зелёный: пакеты собраны и не
       загружены, а в проекте с docker-артефактом вместе с этим job'ом
       пропускается и deploy — он ждёт upload-packages без always(). */}}
      - prepare-env
    if: needs.prepare-env.outputs.ENABLE_BUILD == 'true'
    steps:
      - name: Download packages
        uses: actions/download-artifact@v4
        with:
          name: packages
          path: ./packages

      {{- if .Artifacts.IsMinio }}
      - name: Install MinIO Client
        run: |
          curl -sSL https://dl.min.io/client/mc/release/linux-amd64/mc -o /usr/local/bin/mc
          chmod +x /usr/local/bin/mc

      - name: Configure MinIO Client
        env:
          # Переменные и секреты репозитория приходят переменными окружения, а
          # не текстом команды, — см. комментарий в шаге `Use vars` job'а
          # prepare-env. Ключи доступа при этом ещё и не попадают в файл
          # скрипта на раннере.
          UPLOAD_ENDPOINT: ${{"{{"}} vars.UPLOAD_ENDPOINT {{"}}"}}
          UPLOAD_ACCESS_KEY: ${{"{{"}} secrets.MINIO_ACCESS_KEY {{"}}"}}
          UPLOAD_SECRET_KEY: ${{"{{"}} secrets.MINIO_SECRET_KEY {{"}}"}}
        run: |
          mc alias set minio "$UPLOAD_ENDPOINT" "$UPLOAD_ACCESS_KEY" "$UPLOAD_SECRET_KEY"

      - name: Upload to MinIO
        env:
          UPLOAD_BUCKET: ${{"{{"}} vars.UPLOAD_BUCKET {{"}}"}}
          UPLOAD_PREFIX: ${{"{{"}} vars.UPLOAD_PREFIX || 'packages' {{"}}"}}
        run: |
          mc cp ./packages/* "minio/$UPLOAD_BUCKET/$UPLOAD_PREFIX/"
      {{- else if .Artifacts.IsAWS }}
      - name: Configure AWS credentials
        uses: aws-actions/configure-aws-credentials@v4
        with:
          aws-access-key-id: ${{"{{"}} secrets.AWS_ACCESS_KEY_ID {{"}}"}}
          aws-secret-access-key: ${{"{{"}} secrets.AWS_SECRET_ACCESS_KEY {{"}}"}}
          aws-region: ${{"{{"}} vars.UPLOAD_REGION || 'us-east-1' {{"}}"}}

      - name: Upload to AWS S3
        env:
          # См. комментарий в шаге `Use vars` job'а prepare-env.
          UPLOAD_BUCKET: ${{"{{"}} vars.UPLOAD_BUCKET {{"}}"}}
          UPLOAD_PREFIX: ${{"{{"}} vars.UPLOAD_PREFIX || 'packages' {{"}}"}}
        run: |
          aws s3 cp ./packages/ "s3://$UPLOAD_BUCKET/$UPLOAD_PREFIX/" \
            --recursive
      {{- else if .Artifacts.IsRsync }}
      - name: Setup SSH
        env:
          # Приватный ключ приходит переменной окружения, а не текстом
          # скрипта: иначе он попадает в файл скрипта на раннере. См.
          # комментарий в шаге `Use vars` job'а prepare-env.
          UPLOAD_SSH_PRIVATE_KEY: ${{"{{"}} secrets.UPLOAD_SSH_PRIVATE_KEY {{"}}"}}
          UPLOAD_HOST: ${{"{{"}} vars.UPLOAD_HOST {{"}}"}}
        run: |
          mkdir -p ~/.ssh
          printf '%s\n' "$UPLOAD_SSH_PRIVATE_KEY" > ~/.ssh/id_rsa
          chmod 600 ~/.ssh/id_rsa
          ssh-keyscan -H "$UPLOAD_HOST" >> ~/.ssh/known_hosts

      - name: Upload via rsync
        env:
          # См. комментарий в шаге `Use vars` job'а prepare-env.
          UPLOAD_USER: ${{"{{"}} vars.UPLOAD_USER {{"}}"}}
          UPLOAD_HOST: ${{"{{"}} vars.UPLOAD_HOST {{"}}"}}
          UPLOAD_PATH: ${{"{{"}} vars.UPLOAD_PATH {{"}}"}}
        run: |
          rsync -avz --progress ./packages/ \
            "$UPLOAD_USER@$UPLOAD_HOST:$UPLOAD_PATH/"
      {{- end }}

      - name: Report Upload status
        uses: act10ns/slack@v2
        if: failure()
        with:
          status: ${{"{{"}} job.status {{"}}"}}
          steps: ${{"{{"}} toJson(steps) {{"}}"}}
        env:
          SLACK_WEBHOOK_URL: ${{"{{"}} secrets.ACTION_MONITORING_SLACK {{"}}"}}
{{ end }}
{{ end }}

{{ if .Documentation.IsEnabled }}
  deploy-docs:
    {{ $.GithubCI.JobHeader }}
    needs:
      - prepare-env
    if: needs.prepare-env.outputs.ENABLE_BUILD == 'true' && github.ref == 'refs/heads/main'
{{- if .Documentation.IsGitHubPages }}
    permissions:
      contents: write
{{- end }}
    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
{{- if .Documentation.IsGitHubPages }}
          # The checkout token is kept on purpose: `mkdocs gh-deploy` pushes to
          # the gh-pages branch, which is what `permissions: contents: write`
          # above is granted for.
          fetch-depth: 0
{{- else }}
          persist-credentials: false
{{- end }}
{{- if .Documentation.IsS3 }}

      - name: Build docs
        run: docker run --rm -v ${{"{{"}} github.workspace {{"}}"}}:/docs squidfunk/mkdocs-material build

      - name: Deploy to S3
        env:
          AWS_ACCESS_KEY_ID: ${{"{{"}} secrets.DOCS_AWS_ACCESS_KEY_ID {{"}}"}}
          AWS_SECRET_ACCESS_KEY: ${{"{{"}} secrets.DOCS_AWS_SECRET_ACCESS_KEY {{"}}"}}
          AWS_DEFAULT_REGION: ${{"{{"}} vars.DOCS_REGION || 'us-east-1' {{"}}"}}
          # См. комментарий в шаге `Use vars` job'а prepare-env.
          DOCS_ENDPOINT: ${{"{{"}} vars.DOCS_ENDPOINT {{"}}"}}
          DOCS_BUCKET: ${{"{{"}} vars.DOCS_BUCKET {{"}}"}}
          DOCS_PREFIX: ${{"{{"}} vars.DOCS_PREFIX || '{{ .ProjectName }}' {{"}}"}}
        run: |
          # Массив, а не строка: незаданный endpoint не должен добавить пустой
          # аргумент, а заданный — разойтись по пробелу на несколько.
          ENDPOINT_FLAG=()
          if [ -n "$DOCS_ENDPOINT" ]; then
            ENDPOINT_FLAG=(--endpoint-url "$DOCS_ENDPOINT")
          fi
          aws s3 sync ./site/ "s3://$DOCS_BUCKET/$DOCS_PREFIX/" \
            --delete "${ENDPOINT_FLAG[@]}"
{{- else if .Documentation.IsMinio }}

      - name: Build docs
        run: docker run --rm -v ${{"{{"}} github.workspace {{"}}"}}:/docs squidfunk/mkdocs-material build

      - name: Install MinIO Client
        run: |
          curl -sSL https://dl.min.io/client/mc/release/linux-amd64/mc -o /usr/local/bin/mc
          chmod +x /usr/local/bin/mc

      - name: Deploy to MinIO
        env:
          # См. комментарий в шаге `Use vars` job'а prepare-env. Заголовки
          # сюда же: ToGitHubSecret превращает ${VAR} в ссылку на секрет, то
          # есть в run: значение секрета оказывалось текстом команды.
          DOCS_MINIO_ENDPOINT: ${{"{{"}} vars.DOCS_MINIO_ENDPOINT {{"}}"}}
          DOCS_MINIO_ACCESS_KEY: ${{"{{"}} secrets.DOCS_MINIO_ACCESS_KEY {{"}}"}}
          DOCS_MINIO_SECRET_KEY: ${{"{{"}} secrets.DOCS_MINIO_SECRET_KEY {{"}}"}}
          DOCS_BUCKET: ${{"{{"}} vars.DOCS_BUCKET {{"}}"}}
          DOCS_PREFIX: ${{"{{"}} vars.DOCS_PREFIX || '{{ .ProjectName }}' {{"}}"}}
{{- range $i, $h := .Documentation.Headers }}
          DOCS_HEADER_{{ $i }}: {{ $h | ToGitHubSecret | YAMLQuote }}
{{- end }}
        run: |
          mc alias set docs "$DOCS_MINIO_ENDPOINT" "$DOCS_MINIO_ACCESS_KEY" "$DOCS_MINIO_SECRET_KEY"{{ range $i, $h := .Documentation.Headers }} -H "$DOCS_HEADER_{{ $i }}"{{ end }}
          mc mirror --remove --overwrite{{ range $i, $h := .Documentation.Headers }} -H "$DOCS_HEADER_{{ $i }}"{{ end }} ./site/ "docs/$DOCS_BUCKET/$DOCS_PREFIX/"
{{- else if .Documentation.IsGitHubPages }}

      - name: Deploy to GitHub Pages
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          docker run --rm -v ${{"{{"}} github.workspace {{"}}"}}:/docs squidfunk/mkdocs-material gh-deploy --force
{{- end }}
{{ end }}

{{ if .Artifacts.HasDocker }}
  deploy:
    {{ $.GithubCI.JobHeader }}
    strategy:
      matrix:
        ips: ${{"{{"}} fromJSON(needs.prepare-env.outputs.SSH_HOST_MATRIX) {{"}}"}}
    needs:
      - build
      - create_env_files
      - prepare-env
{{- /* An application with use_envs: true takes its env file from a
       create_<app>_env_files job that the project declares itself, in the user
       section of this workflow (docs/configuration/applications.md). Gated on
       HasDocker too: deploy ships docker artifacts only, so an application
       without one has no env file for this job to wait for — and a needs entry
       naming a job nobody declared makes the whole workflow invalid. */}}
{{- range $_, $a := .Applications }}{{ if and $a.UseEnvs $a.HasDocker }}
      - create_{{ $a.Name | ReplaceDash }}_env_files
{{- end }}{{- end }}
{{- if .Artifacts.HasUpload }}
      - upload-packages
{{- end }}
    if: needs.prepare-env.outputs.ENABLE_DEPLOY == 'true'
    steps:
      - name: Download env file
        uses: actions/download-artifact@v4

      - name: Modify env file
        env:
          # Матрица собрана из переменной репозитория SSH_HOST (через
          # prepare-env), то есть значение того же класса, что и остальные:
          # приходит переменной окружения, а не текстом скрипта. См.
          # комментарий в шаге `Use vars` job'а prepare-env.
          SSH_HOST: ${{"{{"}} matrix.ips[0] {{"}}"}}
          INTERNAL_LAN: ${{"{{"}} matrix.ips[1] {{"}}"}}
        run: |
          for f in $(ls envs-*/.env.*); do
            echo "Processing file: $f"
            printf 'INTERNAL_LAN=%s\n' "$INTERNAL_LAN" >> "$f"
            # Replace deploy-time placeholders (@@SSH_HOST@@, etc.)
            sed -i "s/@@SSH_HOST@@/$SSH_HOST/g" "$f"
          done

      - name: Deploy to Server
        uses: easingthemes/ssh-deploy@main
        with:
          SSH_PRIVATE_KEY: ${{"{{"}} secrets.SSH_PRIVATE_KEY {{"}}"}}
          ARGS: '-rlgoDzvcb -i --delete --backup-dir="../envs_bak" --suffix=`date "+%F_%R"`'
          SOURCE: "./envs*/"
          REMOTE_HOST: ${{"{{"}} matrix.ips[0] {{"}}"}}
          REMOTE_USER: ${{"{{"}} secrets.SSH_USER {{"}}"}}
          TARGET: /opt/{{ .ProjectName }}-cd/envs
          SCRIPT_AFTER_REQUIRED: true
          SCRIPT_AFTER: |
            cd /opt/{{ .ProjectName }}-cd;
            mv envs/docker-compose-*.yaml ./;
            ./deploy.sh || exit 1;
            echo $RSYNC_STDOUT;

      - name: Report Deploy status
        uses: act10ns/slack@v2
        with:
          status: ${{"{{"}} job.status {{"}}"}}
          steps: ${{"{{"}} toJson(steps) {{"}}"}}
          matrix: ${{"{{"}} toJson(matrix) {{"}}"}}
        env:
          SLACK_WEBHOOK_URL: ${{"{{"}} secrets.ACTION_MONITORING_SLACK {{"}}"}}
{{ end }}

  artifact_version:
    {{ $.GithubCI.JobHeader }}
    needs:
      - prepare-env
{{- if .Artifacts.HasDocker }}
      - build
{{- end }}
{{- if .Artifacts.HasPackaging }}
      - build-packages
{{- end }}
    if: always() && needs.prepare-env.outputs.ENABLE_BUILD == 'true'
    env:
      TELEGRAM_BOT_TOKEN: ${{"{{"}} secrets.TELEGRAM_BOT_TOKEN {{"}}"}}
      TELEGRAM_CHAT_ID: ${{"{{"}} secrets.TELEGRAM_CHAT_ID {{"}}"}}
      COMMIT_MSG: ${{"{{"}} github.event.head_commit.message {{"}}"}}
      # Имя ветки, как и сообщение коммита, приходит переменной окружения, а не
      # текстом скрипта: workflow-выражение в run: раскрывается до запуска
      # shell, поэтому имя ветки стало бы частью исходника скрипта (GitHub
      # Security hardening -> script injection). Git допускает в именах веток
      # обратную кавычку, $, " и (), то есть release/$(cmd) выполнила бы
      # команду в job'е с доступом к TELEGRAM_BOT_TOKEN, а release/a`b уронила
      # бы шаг синтаксической ошибкой.
      BRANCH: ${{"{{"}} github.ref_name {{"}}"}}
{{- if .Artifacts.HasDocker }}
      # Списки версий — тоже переменными окружения: RELEASE приходит из
      # `make release-tag` (`git describe --exact-match --tags`), а git
      # допускает `'` в имени тега, то есть в run: имя тега закрывало бы
      # `'…'` и остаток строки читался как код.
      ARTIFACTS: ${{"{{"}} needs.prepare-env.outputs.ARTIFACTS {{"}}"}}
{{- end }}
{{- if .Artifacts.HasPackaging }}
      PACKAGES: ${{"{{"}} needs.prepare-env.outputs.PACKAGES {{"}}"}}
{{- end }}

    steps:
      - name: Check conditions and set message
        run: |
          # $BRANCH и $COMMIT_MSG приходят из env: job'а, см. комментарий там.
{{- if .Artifacts.HasDocker }}
          BUILD_STATUS="${{"{{"}} needs.build.result {{"}}"}}"
{{- end }}
{{- if .Artifacts.HasPackaging }}
          PACKAGES_STATUS="${{"{{"}} needs.build-packages.result {{"}}"}}"
{{- end }}
          RUN_URL="https://github.com/${{"{{"}} github.repository {{"}}"}}/actions/runs/${{"{{"}} github.run_id {{"}}"}}"

          # Проверка секретов
          if [[ -z "$TELEGRAM_BOT_TOKEN" || -z "$TELEGRAM_CHAT_ID" ]]; then
            echo "MESSAGE=" >> $GITHUB_ENV
            exit 0
          fi

          # Ветка не проверяется: job гейтится на
          # needs.prepare-env.outputs.ENABLE_BUILD == 'true', то есть
          # уведомление приходит о каждой ветке, на которой включена сборка.

          # Определяем общий статус
          STATUS="success"
{{- if .Artifacts.HasDocker }}
          if [[ "$BUILD_STATUS" != "success" ]]; then
            STATUS="failure"
          fi
{{- end }}
{{- if .Artifacts.HasPackaging }}
          if [[ "$PACKAGES_STATUS" != "success" ]]; then
            STATUS="failure"
          fi
{{- end }}

          # Экранируем commit message для MarkdownV2 (берём только первую строку)
          # Символы для экранирования: _ * [ ] ( ) ~ ` > # + - = | { } . !
          ESCAPED_COMMIT_MSG=$(echo "$COMMIT_MSG" | head -1 | sed 's/[][_*()~`>#+=|{}.!-]/\\&/g')

          # Имя ветки экранируется тем же правилом: среди имён, которые
          # допускает github_ci.push_branches, спецсимволы MarkdownV2 — обычное
          # дело (release/1.2, hotfix-x, feature_x), а на неэкранированном
          # Telegram отвечает 400 и сообщения нет — причём незаметно, потому
          # что `curl -s` этой ошибки не видит и job остаётся зелёным.
          ESCAPED_BRANCH=$(echo "$BRANCH" | sed 's/[][_*()~`>#+=|{}.!-]/\\&/g')

          # Формирование сообщения
          MESSAGE="Репозиторий: *$(echo "${{"{{"}} github.repository {{"}}"}}" | sed 's/[][_*()~`>#+=|{}.!-]/\\&/g')*
          Коммит: _${ESCAPED_COMMIT_MSG}_"

          if [[ "$STATUS" == "success" ]]; then
            MESSAGE="$MESSAGE
            ✅ Успех: *${{"{{"}} github.workflow {{"}}"}}* завершен на ветке *$ESCAPED_BRANCH*"
{{- if .Artifacts.HasDocker }}
            DOCKER_VERS=$(printf '%s\n' "$ARTIFACTS" | jq -r '.[]' | sed 's/[][_*()~`>#+=|{}.!-]/\\&/g')
            MESSAGE="$MESSAGE

            *Docker образы:*
            ${DOCKER_VERS}"
{{- end }}
{{- if .Artifacts.HasPackaging }}
            PKG_VERS=$(printf '%s\n' "$PACKAGES" | jq -r '.[]' | sed 's/[][_*()~`>#+=|{}.!-]/\\&/g')
            MESSAGE="$MESSAGE

            *Пакеты:*
            ${PKG_VERS}"
{{- end }}
          else
            MESSAGE="$MESSAGE
            ❌ Ошибка: *${{"{{"}} github.workflow {{"}}"}}* завершился с ошибкой на ветке *$ESCAPED_BRANCH*"
          fi

          MESSAGE="$MESSAGE
          [Посмотреть билд](${RUN_URL})"

          curl -s -X POST https://api.telegram.org/bot$TELEGRAM_BOT_TOKEN/sendMessage \
            -d chat_id=$TELEGRAM_CHAT_ID \
            -d text="$MESSAGE" \
            -d parse_mode="MarkdownV2"
