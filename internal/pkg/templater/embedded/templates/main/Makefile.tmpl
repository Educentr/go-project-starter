{{ if eq $proto true }}
# Install dependencies for protobuf generator
.PHONY: install-buf
install-buf:
	mkdir -p "$(GOBIN_DIR)"
	curl -sSL \
    	"https://github.com/bufbuild/buf/releases/download/v${BUF_VERSION}/buf-$(shell uname -s)-$(shell uname -m)" \
    	-o "$(GOBIN_DIR)/buf" && \
  	chmod +x "$(GOBIN_DIR)/buf"

# Install protoc-gen-go and protoc-gen-go-grpc
# Pin protoc-gen-go-grpc: v1.6.2 bumped the required Go version to 1.25.0,
# which breaks generated projects pinned to Go 1.24. v1.6.1 is the last
# release still compatible.
.PHONY: install-protoc-gen-go-grpc
install-protoc-gen-go-grpc:
	go install google.golang.org/protobuf/cmd/protoc-gen-go@latest
	go install google.golang.org/grpc/cmd/protoc-gen-go-grpc@v1.6.1
{{- if $bufLocal }}

# buf and the local protoc plugins it shells out to (buf.gen.yaml uses
# "local: protoc-gen-go" / "local: protoc-gen-go-grpc") have to be on PATH for
# the `buf generate` in the proto target. Guarded rather than an unconditional
# prerequisite: toolchain images bake these binaries, and installing them on
# every run would both hit the network and shadow the baked ones via GOBIN_DIR.
.PHONY: ensure-buf
ensure-buf:
	@command -v buf >/dev/null 2>&1 || $(MAKE) --no-print-directory install-buf

.PHONY: ensure-protoc-plugins
ensure-protoc-plugins:
	@{ command -v protoc-gen-go && command -v protoc-gen-go-grpc; } >/dev/null 2>&1 || $(MAKE) --no-print-directory install-protoc-gen-go-grpc
{{- end }}
{{- end }}

