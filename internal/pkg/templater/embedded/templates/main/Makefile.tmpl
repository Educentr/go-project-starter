{{ if .Documentation.IsEnabled }}
# Documentation
{{- if .Documentation.IsS3 }}
# Required environment variables for docs-deploy:
#   DOCS_BUCKET   - Target S3 bucket name (required)
#   DOCS_REGION   - Bucket region (optional, default: us-east-1)
#   DOCS_ENDPOINT - S3 endpoint URL (optional, for S3-compatible storage)
#   DOCS_PREFIX   - Path prefix in bucket (optional, default: $(SERVICE_NAME))
DOCS_REGION ?= us-east-1
DOCS_PREFIX ?= $(SERVICE_NAME)
{{- end }}

MKDOCS_IMAGE = squidfunk/mkdocs-material
MKDOCS_RUN = docker run --rm -v $(PWD):/docs -w /docs $(MKDOCS_IMAGE)

.PHONY: docs-build
docs-build:
	@echo "Building documentation..."
	@$(MKDOCS_RUN) build

.PHONY: docs-serve
docs-serve:
	@docker run --rm -p 8000:8000 -v $(PWD):/docs $(MKDOCS_IMAGE) serve --dev-addr=0.0.0.0:8000

.PHONY: docs-deploy
{{- if .Documentation.IsS3 }}
docs-deploy: docs-build
	@echo "Deploying documentation to S3..."
	@if [ -n "$(DOCS_ENDPOINT)" ]; then \
		aws s3 sync ./site/ s3://$(DOCS_BUCKET)/$(DOCS_PREFIX)/ --delete --endpoint-url $(DOCS_ENDPOINT) --region $(DOCS_REGION); \
	else \
		aws s3 sync ./site/ s3://$(DOCS_BUCKET)/$(DOCS_PREFIX)/ --delete --region $(DOCS_REGION); \
	fi
	@echo "Documentation deployed"
{{- else if .Documentation.IsMinio }}
# MinIO docs deployment variables:
#   DOCS_ENDPOINT   - MinIO endpoint URL (required)
#   DOCS_BUCKET     - Target bucket name (required)
#   DOCS_ACCESS_KEY / DOCS_SECRET_KEY - MinIO credentials (required)
DOCS_PREFIX ?= $(SERVICE_NAME)

docs-deploy: docs-build
	@echo "Deploying documentation to MinIO..."
	@mc alias set docs $(DOCS_ENDPOINT) $(DOCS_ACCESS_KEY) $(DOCS_SECRET_KEY)
	@mc mirror --remove --overwrite{{ range .Documentation.Headers }} --header "{{ . }}"{{ end }} ./site/ docs/$(DOCS_BUCKET)/$(DOCS_PREFIX)/
	@echo "Documentation deployed"
{{- else if .Documentation.IsGitHubPages }}
docs-deploy:
	@echo "Deploying documentation to GitHub Pages..."
	@$(MKDOCS_RUN) gh-deploy --force
{{- end }}
{{ end }}
.PHONY: build
build: {{ range $_, $a := .Applications }}build-{{ $a.Name }} {{ end }}

