# OnlineConf validator — the enforcing half of the OnlineConf key map.
#
# The map gives this project typed accessors to read through (see
# {{ .OnlineConf.GetPackagePath }}); this config makes that the ONLY way to
# read. Without it the declaration would be a convention: nothing stops a
# developer from writing one more onlineconf.MakePath next to the generated
# accessors, and that is exactly the shape the map exists to remove — a path
# assembled out of private segment constants is invisible to every tool that
# would otherwise check it against the declaration.
#
# Every project gets this check, with or without `onlineconf.path` in
# project.yaml: the generated code reads OnlineConf everywhere, so half of the
# map is always there and the guard has to hold everywhere too.
#
# Run it with `make onlineconf-validate`.
#
# The rule bans the onlineconf package as a whole, not just its readers.
# Banning only Get* would leave MakePath free to build a path for some other
# reader; banning only MakePath would leave a bare string literal free. One
# rule over the package closes both.
#
# `analyze-types` is what makes the pattern name the package rather than the
# spelling at the call site. Without it forbidigo matches the literal source
# text, so `oc "…/onlineconf"` + `oc.GetString(…)` — or a dot-import calling
# `GetString(…)` bare — walks straight past a rule written for
# `onlineconf.GetString`. A gate that an import alias defeats is not a gate.
version: "2"
run:
  concurrency: 4
  issues-exit-code: 10
  tests: true
linters:
  default: none
  enable:
    - forbidigo
  settings:
    forbidigo:
      # Resolve the called identifier through type information, so the rule
      # also catches an aliased or dot-imported call of the same function.
      analyze-types: true
      forbid:
{{- range $_, $rule := .OnlineConf.ForbiddenCalls }}
        - pattern: '{{ $rule.Pattern }}'
          msg: "{{ $rule.Msg }}"
{{- end }}
  exclusions:
    # Deliberately NOT `lax`: `lax` keys off the generated-file header, and the
    # exemption below is narrower and explicit about why each path is exempt.
    generated: disable
    rules:
      # One exemption, and only one: the generated accessor package, which is
      # where OnlineConf IS read.
      #
      # Generated files used to be exempt as a class, because the generated code
      # read the generator's own keys directly. That left a hole — the manual
      # section below the disclaimer marker of a psg_*_gen.go file could read any
      # key and nothing would notice. The generated code reads through the
      # accessors now, so the exemption is gone and the hole with it.
      - linters:
          - forbidigo
        path: {{ .OnlineConf.ExemptPathPattern }}
    paths:
      - third_party$
      - builtin$
      - examples$
{{- range $_, $p := .LintExcludePaths }}
      - {{ $p }}
{{- end }}
issues:
  max-issues-per-linter: 0
  max-same-issues: 0
