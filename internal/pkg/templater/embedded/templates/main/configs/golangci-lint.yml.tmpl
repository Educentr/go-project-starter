version: "2"
run:
  concurrency: 4
  issues-exit-code: 10
  tests: true
linters:
  enable:
    - asasalint
    - asciicheck
    - bidichk
    - bodyclose
    - containedctx
    - contextcheck
    - decorder
    - dupl
    - dupword
    - durationcheck
    - err113
    - errchkjson
    - errname
    - errorlint
    - exhaustive
    - forbidigo
    - forcetypeassert
    - funlen
    - ginkgolinter
    - gocheckcompilerdirectives
    # Мутабельное package-level состояние: менять его может кто угодно в пакете, а
    # два экземпляра (два воркера, два драйвера) делят одно значение. Точки
    # расширения сгенерированного кода — поля и сеттеры, а не подменяемые глобалы,
    # поэтому линтер включён (TOOLS-31). Для _test.go исключён (см.
    # exclusions.rules): табличные тесты держат наборы случаев в package-level
    # переменных, и запрет там ничего не защищает.
    - gochecknoglobals
    # init() — неявный side-effect при импорте, зависящий от порядка инициализации
    # пакетов. Точки расширения сгенерированного кода объявлены так, что init() для
    # них не нужен, поэтому линтер включён и НЕ исключён для _test.go (TOOLS-30).
    - gochecknoinits
    - goconst
    - gocritic
    - gocyclo
    - goprintffuncname
    - gosec
    - grouper
    - importas
    - interfacebloat
    - lll
    - loggercheck
    - makezero
    - misspell
    - mnd
    - musttag
    - nakedret
    - nestif
    - nilerr
    - nilnil
    - noctx
    - nolintlint
    - nosprintfhostport
    - prealloc
    - predeclared
    - promlinter
    - reassign
    - revive
    - rowserrcheck
    - sqlclosecheck
    - staticcheck
    - thelper
    - unconvert
    - usestdlibvars
    - whitespace
    - wsl
  settings:
    asasalint:
      use-builtin-exclusions: true
    decorder:
      dec-order:
        - type
        - const
        - var
        - func
      disable-dec-num-check: true
      disable-dec-order-check: false
      disable-init-func-first-check: false
    dupl:
      threshold: 150
    errcheck:
      disable-default-exclusions: false
      check-type-assertions: false
      check-blank: true
      exclude-functions:
        - encoding/json.Marshal
        - encoding/json.MarshalIndent
    errchkjson:
      check-error-free-encoding: true
      report-no-exported: false
    errorlint:
      errorf: true
      errorf-multi: true
      asserts: true
      comparison: true
    exhaustive:
      check:
        - switch
        - map
      default-signifies-exhaustive: true
    # Declaration validators — the same rules the dedicated gates carry, so
    # that `make lint` catches the typical case right away:
{{- if .Metrics.IsEnabled }}
    # metric constructors belong in the generated collector package only
    # (configs/golangci-metrics.yml, `make metrics-validate`);
{{- end }}
    # OnlineConf is read through the generated accessor package only
    # (configs/golangci-onlineconf.yml, `make onlineconf-validate`).
    forbidigo:
      # Match on the resolved package, not on the spelling at the call site —
      # otherwise an import alias defeats the rule. See the dedicated validator
      # configs for the full reasoning.
      analyze-types: true
      forbid:
{{- if .Metrics.IsEnabled }}
{{- range $_, $rule := .Metrics.ForbiddenConstructors }}
        - pattern: '{{ $rule.Pattern }}'
          msg: "{{ $rule.Msg }}"
{{- end }}
{{- end }}
{{- range $_, $rule := .OnlineConf.ForbiddenCalls }}
        - pattern: '{{ $rule.Pattern }}'
          msg: "{{ $rule.Msg }}"
{{- end }}
    funlen:
      lines: -1
      statements: 40
    goconst:
      match-constant: true
      min-len: 3
      min-occurrences: 2
      numbers: true
      min: 3
      max: 3
      ignore-calls: false
    gocyclo:
      min-complexity: 20
    lll:
      line-length: 160
      tab-width: 8
    misspell:
      locale: US
    nestif:
      min-complexity: 10
    wsl:
      strict-append: true
      allow-assign-and-call: true
      allow-assign-and-anything: false
      allow-multiline-assign: true
      force-case-trailing-whitespace: 0
      allow-trailing-comment: false
      allow-separated-leading-comment: false
      allow-cuddle-declarations: false
      allow-cuddle-with-calls:
        - Lock
        - RLock
      allow-cuddle-with-rhs:
        - Unlock
        - RUnlock
      force-err-cuddling: false
      error-variable-names:
        - err
      force-short-decl-cuddling: false
  exclusions:
    generated: lax
    presets:
      - comments
      - common-false-positives
      - legacy
      - std-error-handling
    rules:
      - linters:
          - containedctx
          - contextcheck
          - dupl
          - dupword
          - err113
          - errname
          - exhaustive
          - forcetypeassert
          - funlen
          - gochecknoglobals
          - goconst
          - gocritic
          - gocyclo
          - gosec
          - lll
          - nilerr
          - noctx
          - promlinter
          - reassign
          - unparam
        path: _test\.go
      - linters:
          - goconst
        path: (.+)_test\.go
{{- if .Metrics.IsEnabled }}
      # The generated collector package is where metrics ARE constructed, and
      # the generated Kafka producer driver needs its own per-producer
      # collectors (the producer name is a ConstLabel). Both are generated in
      # full from the declaration — they are not hand-written escape hatches.
      - linters:
          - forbidigo
        path: ({{ .Metrics.GetPackagePath }}/|pkg/drivers/kafka/)
{{- end }}
      # The generated accessor package is where OnlineConf IS read. It is the
      # only exemption: generated files used to be exempt as a class, which let
      # the manual section below the disclaimer marker of a psg_*_gen.go file
      # read any key unnoticed. See configs/golangci-onlineconf.yml.
      - linters:
          - forbidigo
        path: {{ .OnlineConf.ExemptPathPattern }}
    paths:
      - third_party$
      - builtin$
      - examples$
{{- range $_, $p := .LintExcludePaths }}
      - {{ $p }}
{{- end }}
issues:
  max-issues-per-linter: 0
  max-same-issues: 0
formatters:
  enable:
    - goimports
  settings:
    gci:
      sections:
        - standard
        - default
        - blank
        - dot
      custom-order: true
  exclusions:
    generated: lax
    paths:
      - third_party$
      - builtin$
      - examples$
{{- range $_, $p := .LintExcludePaths }}
      - {{ $p }}
{{- end }}
      - _test\.go
