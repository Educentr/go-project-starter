#
# The complete OnlineConf surface of this service: every path in the
# /{{ .OnlineConf.TreeRoot }} tree that anything in this project reads.
#
# Everything here is reached through one generated package,
# {{ .OnlineConf.GetPackagePath }} — `make onlineconf-validate` forbids reading
# OnlineConf anywhere else. `accessor` names the function, `read_via` names it
# when the read goes through a shared accessor whose path its caller composes.
#
# Two origins, and the difference matters when you change something:
#
#   origin: service   — declared in the service's OnlineConf key map (the
#                       contract). To add, change or remove one, change the map.
#   origin: generated — declared by the generator, next to the template whose
#                       code reads it. Not declarable in the service map: a
#                       second declaration would mean a second reader with a
#                       second spelling, which is the thing the map exists to
#                       prevent. `read_by` names the templates the read comes
#                       from — all of them, including alternatives of which this
#                       project generates one (the two loggers read the same
#                       keys, so both are listed).
#
# A `<name>` segment is one that is computed at runtime — the url path of a
# request, a telegram user id, an account id — and it is a parameter of the
# accessor named in the row.
#
# On an `origin: generated` row, `owns` then names the point from which the
# subtree as a whole belongs to the generated code: there is no single path to
# compare against, so the service map may not declare inside it. An
# `origin: service` row claims nothing — the service's own code reads exactly the
# paths the row names — but the paths it reaches are checked against every
# generated read at generation time, which is why a row like this one and a
# generated row never meet.
#
# A row with no `type` is a path the generated code is handed as a prefix and
# reads below. Without `owns`, its subtree is open: every read the generated code
# performs there is a row of its own, so the service map may declare its own keys
# beside them — the settings the handwritten code of a worker reads under
# /<service>/worker/<name> are declared exactly that way.
#
# `required: true` marks a key the startup check verifies. A generated one is
# checked only in the applications that run the component reading it — so it is
# not set for a component every application of this project wires
# `optional: true`, because then no check is generated for it anywhere.
#
# `required_at_init: true` marks a key this service does not start without —
# whoever seeds the tree has to set it, and a guard over this file is how that
# is checked before a deploy finds out. Every `required` key is one (the check
# failing is the failed start), and so is a key no check covers but whose
# component reports it missing while coming up: the host of a generated client,
# for instance, which no check can demand because a client declared
# `instantiation: dynamic` or `optional: true` does not need it. The flag is
# already the answer for THIS project's settings — it is not set on a path that
# the project's own configuration makes unnecessary, so the whole list applies.
# `optional: true` makes a key unnecessary only where EVERY application wiring
# the component declares it so: one wiring without it is one process that
# refuses to start, and that is a key to seed. The component is the one the
# path segment names, which for a Kafka client is all the producers configured
# under it: the brokers key is on the list unless every one of them is optional
# in every application wiring it.
#
# This file is for reading and diffing: nothing in the service loads it. It is
# regenerated on every run, so a diff here is a change to the configuration
# surface of the service, which is exactly the thing worth reviewing.
#
tree: /{{ .OnlineConf.TreeRoot }}

keys:
{{- range $_, $e := .OnlineConf.Surface }}
  - path: {{ $e.Path }}
    origin: {{ $e.Origin }}
{{- if $e.Type }}
    type: {{ $e.Type }}
{{- end }}
{{- if $e.Required }}
    required: true
{{- end }}
{{- if $e.RequiredAtInit }}
    required_at_init: true
{{- end }}
{{- if $e.Accessor }}
    accessor: {{ $e.Accessor }}
{{- end }}
{{- if $e.ReadVia }}
    read_via: {{ $e.ReadVia }}
{{- end }}
{{- if $e.Owns }}
    owns: {{ $e.Owns }}
{{- end }}
{{- if $e.HasDefault }}
    default: {{ $e.Default | YAMLString }}
{{- end }}
{{- if $e.ReadBy }}
    read_by: [{{ range $i, $t := $e.ReadBy }}{{ if $i }}, {{ end }}{{ $t | YAMLString }}{{ end }}]
{{- end }}
{{- if $e.Description }}
    description: {{ $e.Description | YAMLString }}
{{- end }}
{{- end }}
